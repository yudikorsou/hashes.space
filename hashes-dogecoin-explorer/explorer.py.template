        return ("<div class='fbox" + (" " + cls if cls else "") + (" ver" if v else "") + "'>" + mark + (("<a class='mono addr' href='/address/" + html.escape(addr) + "'>" + html.escape(addr) + "</a>") if valid_address(addr) else "<span class='mono addr'>" + html.escape(addr) + "</span>")
                + ("<span class=amt>" + value + "</span>" if value else "") + ("<em class=ftag>" + tag + "</em>" if tag else "") + "</div>")
    if f["coinbase"]:
        left = box("New coins", doge(f["total_out"]), "the block reward and the fees, created by this block", "new")
