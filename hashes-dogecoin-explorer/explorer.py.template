def candidate_parts():
    t = doge_template()
    work = t["diff"] * 4294967296.0          # the tries a block takes on average (Scrypt, difficulty 1 = 2^32 tries)
    rate = work / BLOCK_SECONDS
    hv, hu = hashrate_text(rate)
    since = max(0, int(time.time()) - t["last"])
    chance = 1 - math.exp(-60.0 / BLOCK_SECONDS)
    zeros = max(1, int(math.log(work, 16)))
    pct = min(100, since / BLOCK_SECONDS * 100)
    s1 = st("1", "The header is ready", "the block your node built, <a href='/block-assembly'>step by step</a>",
            "<div class=big2>Block " + "{:,}".format(t["height"]) + "</div><div class=sub>" + "{:,}".format(len(t["txs"])) + " transactions · " + "{:,.1f}".format(t["size"] / 1000.0) + " kB · merkle root <span class=mono>" + short(t["root"], 8, 6) + "</span></div>"
            "<div class=sub>builds on <a class=mono href='/block/" + str(t["height"] - 1) + "'>" + short(t["prev"], 8, 6) + "</a></div>", "s1")
    s2 = st("2", "Miners change the nonce and hash", "every miner hashes the same header with different nonces (Scrypt, merge-mined with Litecoin)",
            "<div class=big2>" + hv + " <small>" + hu + "</small></div><div class=sub>about what the whole network tries every second</div>", "s2")
    s3 = st("3", "Look for a lucky hash", "the block is found when the hash falls under the target: about " + str(zeros) + " zeros at the start",
            "<div class=big2>1 in " + "{:,.0f}".format(work) + "</div><div class=sub>tries win: that is the difficulty times 2³². The network adjusts it after every block so a block takes about " + str(BLOCK_SECONDS) + " seconds.</div>", "s3")
    s4 = st("4", "Found? Pass it on", "the winner sends the candidate plus its nonce to the network, with the Litecoin proof that merge-mining adds (AuxPoW)",
            "<div class=big2><span id=since>" + "{}:{:02d}".format(since // 60, since % 60) + "</span> <small>since the last block</small></div><div class=fill id=sfill><i style='width:" + "{:.0f}".format(pct) + "%'></i></div>"
            "<div class=sub>About <b id=tries>–</b> tries by all miners since then, <span id=ratio>–</span> × the average. On average " + str(BLOCK_SECONDS // 60) + ":" + "{:02d}".format(BLOCK_SECONDS % 60)
            + "; a block comes in the next minute with a chance of " + "{:.0f}".format(chance * 100) + "%.</div>", "s4")
    chips = chips_of(t, "<span class=chip>hashing now</span>")
    return {"chips": chips, "steps": s4 + s1 + s2 + s3, "height": t["height"], "last": t["last"], "work": work, "rate": rate, "zeros": zeros, "ntx": len(t["txs"]), "prev": t["prev"], "root": t["root"], "weight": t["size"], "limit": t["limit"]}


