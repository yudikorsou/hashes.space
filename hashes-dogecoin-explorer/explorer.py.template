# ----- 1. Fee sorting -----

def fee_parts():
    t = doge_template()
    rows, inb = t["rows"], {x[0] for x in t["txs"]}
    total, fit = len(rows), len(t["txs"])
    top = rows[0][0] if rows else 0
    med = rows[len(rows) // 2][0] if rows else 0
    low = min((r[0] for r in rows if r[1] in inb), default=0)
    chips = chips_of(t, "<span class=chip><b>" + "{:,}".format(total) + "</b> waiting</span>")
    unit = "koinu/B"
    steps = (st("1", "Collect what waits", "the unconfirmed transactions in your node's mempool",
                "<div class=big2>" + "{:,}".format(total) + " <small>transactions</small></div><div class=sub>" + "{:,.1f}".format(t["poolBytes"] / 1000.0) + " kB"
                + ((" · the node relays nothing below " + "{:,.0f}".format(t["minrelay"]) + " " + unit) if t["minrelay"] else "") + "</div>", "s1")
             + st("2", "Rate each one", "fee ÷ size: the koinu it pays the miner for every byte it takes",
                  "<div class=big2>" + "{:,.0f}".format(top) + " <small>" + unit + " at the top</small></div><div class=sub>median " + "{:,.0f}".format(med) + " " + unit + "</div>", "s2")
             + st("3", "Sort, best rate first", "a transaction that spends another one waits for it, so a parent always goes before its child",
                  "<div class=big2>#1 → #" + "{:,}".format(total) + "</div><div class=sub>" + ("the highest rate is " + "{:,.0f}".format(top / med) + "× the median" if med else "nothing is waiting") + "</div>", "s3")
             + st("4", "Fill the block", "from the top until the block is full (" + "{:,}".format(t["limit"]) + " bytes at most, 1,000 kept for the coinbase)",
                  "<div class=big2>" + "{:,}".format(fit) + " <small>of " + "{:,}".format(total) + " fit</small></div><div class=fill><i style='width:" + "{:.0f}".format(min(100, t["size"] / t["limit"] * 100)) + "%'></i></div>"
                  "<div class=sub>" + "{:,.1f}".format(t["size"] / 1000.0) + " kB · fees " + doge(t["fees"]) + (" · it takes about " + "{:,.0f}".format(low) + " " + unit + " to get in" if fit and total > fit else "") + "</div>", "s4"))
    n = len(rows)
    bars = [round(rows[int(i * (n - 1) / 6)][0], 1) for i in range(7)] if n >= 2 else []

    def row(i, r):
        rate, txid, size, fee = r
        pct = max(3, int(rate / top * 100)) if top else 0
        return ("<tr class='" + ("in" if txid in inb else "out") + "'><td class=n>" + str(i + 1) + "</td><td class=bar><div><span style='width:" + str(pct) + "%'></span><b>" + "{:,.0f}".format(rate) + "</b></div></td>"
                "<td class=r>" + "{:,.4f}".format(fee / COIN).rstrip("0").rstrip(".") + "</td><td class=r>" + "{:,}".format(size) + "</td><td><a class=mono href='/tx/" + txid + "'>" + txid[:6] + "…" + txid[-4:] + "</a></td></tr>")
    th = "<tr><th>#</th><th>Fee rate (koinu/B)</th><th class=r>Fee (DOGE)</th><th class=r>Bytes</th><th>Tx</th></tr>"

    def lines(idx):
        out, cut = [], False
        for i in idx:
            if rows[i][1] not in inb and not cut and fit:
                cut = True
                out.append("<tr class=cut><td colspan=5><span>Block full · " + "{:,}".format(t["size"]) + " of " + "{:,}".format(t["limit"]) + " bytes · the rest waits</span></td></tr>")
            out.append(row(i, rows[i]))
        return "".join(out)
    cut_at = next((i for i, r in enumerate(rows) if r[1] not in inb), total)
    short_idx = list(range(min(6, total))) + ([i for i in range(max(6, cut_at - 1), min(cut_at + 3, total))] if cut_at < total else [])
    short_idx = sorted(set(short_idx))
    table = ("<table class=rank>" + th + lines(short_idx) + "</table>" + ("<details><summary>Show all " + "{:,}".format(total) + (" (first 200)" if total > 200 else "") + "</summary><table class=rank>" + th + lines(list(range(min(total, 200)))) + "</table></details>" if total > len(short_idx) else "")
             if rows else "<p class=muted>No transactions are waiting right now: the next block holds only the coinbase.</p>")
    return {"chips": chips, "steps": steps, "table": table, "height": t["height"], "fit": fit, "total": total, "bars": bars, "top": top, "med": med,
            "rows": [[r[1], round(r[0], 1), r[3], r[2], 1 if r[1] in inb else 0] for r in rows[:3000]], "low": round(low, 1)}


