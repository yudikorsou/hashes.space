           + "<b>" + doge(sent if not f["coinbase"] else f["total_out"]) + "</b><span>" + ("to the miner" if f["coinbase"] else "sent on") + "</span>"
           + (("<span>fee " + doge(f["fee"]) + "</span>") if f["fee"] else "") + "</div>")
    right = "".join(box(o["addr"] or "no address (" + o["script"][:24] + ")", doge(o["value"]),
                        "change back to the sender" if o.get("change") else "", "chg" if o.get("change") else "") for o in f["outs"])
    return "<div class=flow><div class=fcol><small>From</small>" + left + "</div>" + mid + "<div class=fcol><small>To</small>" + right + "</div></div>"


def donation_chips(tx):
    """a chip for every verified organisation this transaction pays (change going back to a verified sender does not count)"""
    senders = {sender_address(i["script"]) for i in tx["vin"]}
    seen, out = set(), ""
    for o in tx["vout"]:
        a = address(o["script"])
        if a in VERIFIED and a not in senders and a not in seen:
            seen.add(a)
            out += "<a class=vchip href='/address/" + a + "'>✔ " + doge(sum(x["value"] for x in tx["vout"] if address(x["script"]) == a)) + " to " + html.escape(VERIFIED[a]["name"]) + "</a>"
    return out


