"""Dogecoin block explorer for Umbrel, on your own Dogecoin Core node (Python standard library only).

Reads everything from the Dogecoin Core app's RPC: blocks (parsed from the raw block, AuxPoW included),
transactions and the mempool. Serves:

  /                      latest blocks and the mempool
  /block/<hash|height>   a block with its transactions
  /tx/<txid>             a transaction (mempool, a block from this explorer, or any tx with -txindex)
  /search?q=             height, block hash or txid
  /api/v1/blocks         the last blocks, in mempool.space's format (for hashes.space)
  /api/v1/fees/mempool-blocks   the mempool cut into blocks of 1 MB, best fee first
  /api/blocks/tip/height
  /api/v1/mining/hashrate/1y    global hashrate (one point a day) and difficulty, from your node
  /api/v1/mining/pools/1w       blocks per mining pool over the last week (10,080 blocks)
  /api/v1/ws             mempool.space's WebSocket: {"action":"want","data":["blocks","mempool-blocks"]}

Fees are in koinu per byte (1 DOGE = 100,000,000 koinu).
"""

import base64
import hashlib
import html
import json
import os
import re
import socket
import struct
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("PORT", "3000"))
RPC_URL = "http://" + os.environ["RPC_HOST"] + ":" + os.environ["RPC_PORT"] + "/"
AUTH = "Basic " + base64.b64encode((os.environ["RPC_USER"] + ":" + os.environ["RPC_PASS"]).encode()).decode()
COIN = 100_000_000
SUBSIDY = 10_000 * COIN  # every Dogecoin block since height 600,000
MAX_BLOCK = 1_000_000
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
HEX64 = re.compile(r"[0-9a-fA-F]{64}")


def log(msg):
    print("[explorer] " + msg, flush=True)


class RpcError(Exception):
    pass


def rpc(method, *params):
    body = json.dumps({"jsonrpc": "1.0", "id": "x", "method": method, "params": list(params)}).encode()
    req = urllib.request.Request(RPC_URL, data=body, headers={"Authorization": AUTH, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            payload = json.loads(exc.read())
        except Exception:  # noqa: BLE001
            raise RpcError("HTTP " + str(exc.code))
    except OSError as exc:
        raise RpcError("Dogecoin Core is not reachable: " + str(exc))
    if payload.get("error"):
        raise RpcError(payload["error"].get("message", "RPC error"))
    return payload["result"]


def rpc_batch(calls):
    """several RPC calls in one request: [(method, params), ...] -> results (None where a call failed)"""
    body = json.dumps([{"jsonrpc": "1.0", "id": i, "method": m, "params": list(p)} for i, (m, p) in enumerate(calls)]).encode()
    req = urllib.request.Request(RPC_URL, data=body, headers={"Authorization": AUTH, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            out = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        out = json.loads(exc.read())
    except OSError as exc:
        raise RpcError("Dogecoin Core is not reachable: " + str(exc))
    res = [None] * len(calls)
    for item in out:
        if not item.get("error"):
            res[item["id"]] = item["result"]
    return res


# ---------- raw block and transaction parsing (Dogecoin: no SegWit, AuxPoW merge-mined headers) ----------

def sha256d(b):
    return hashlib.sha256(hashlib.sha256(b).digest()).digest()


class Reader:
    def __init__(self, data):
        self.d = data
        self.i = 0

    def take(self, n):
        out = self.d[self.i:self.i + n]
        if len(out) < n:
            raise ValueError("block data ended early")
        self.i += n
        return out

    def u32(self):
        return struct.unpack("<I", self.take(4))[0]

    def i32(self):
        return struct.unpack("<i", self.take(4))[0]

    def u64(self):
        return struct.unpack("<Q", self.take(8))[0]

    def varint(self):
        n = self.take(1)[0]
        if n < 0xFD:
            return n
        return struct.unpack("<" + {0xFD: "H", 0xFE: "I", 0xFF: "Q"}[n], self.take({0xFD: 2, 0xFE: 4, 0xFF: 8}[n]))[0]

    def varbytes(self):
        return self.take(self.varint())


def read_tx(r):
    start = r.i
    version = r.i32()
    vin = []
    for _ in range(r.varint()):
        prev = r.take(32)[::-1].hex()
        index = r.u32()
        script = r.varbytes()
        seq = r.u32()
        vin.append({"prev": prev, "n": index, "script": script, "seq": seq})
    vout = []
    for _ in range(r.varint()):
        value = r.u64()
        vout.append({"value": value, "script": r.varbytes()})
    locktime = r.u32()
    raw = r.d[start:r.i]
    return {"txid": sha256d(raw)[::-1].hex(), "version": version, "vin": vin, "vout": vout, "locktime": locktime, "size": len(raw),
            "coinbase": len(vin) == 1 and vin[0]["prev"] == "0" * 64}


def parse_block(raw_hex):
    r = Reader(bytes.fromhex(raw_hex))
    version = r.i32()
    r.take(76)  # rest of the 80-byte header
    parent_coinbase = None
    if version & 0x100:  # AuxPoW: the block was merge-mined (with Litecoin, mostly)
        parent_coinbase = read_tx(r)
        r.take(32)
        r.take(32 * r.varint())
        r.take(4)
        r.take(32 * r.varint())
        r.take(4)
        r.take(80)
    txs = [read_tx(r) for _ in range(r.varint())]
    return {"txs": txs, "parent_coinbase": parent_coinbase}


# ---------- addresses (base58check, Dogecoin mainnet) ----------

B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def b58check(prefix, payload):
    data = bytes([prefix]) + payload
    data += sha256d(data)[:4]
    n = int.from_bytes(data, "big")
    out = ""
    while n:
        n, rem = divmod(n, 58)
        out = B58[rem] + out
    return "1" * (len(data) - len(data.lstrip(b"\0"))) + out


def address(script):
    if len(script) == 25 and script[:3] == b"\x76\xa9\x14" and script[23:] == b"\x88\xac":
        return b58check(0x1E, script[3:23])  # P2PKH, starts with D
    if len(script) == 23 and script[:2] == b"\xa9\x14" and script[22] == 0x87:
        return b58check(0x16, script[2:22])  # P2SH, starts with 9 or A
    if len(script) in (35, 67) and script[-1] == 0xAC:
        return b58check(0x1E, hashlib.new("ripemd160", hashlib.sha256(script[1:-1]).digest()).digest())  # P2PK
    if script[:1] == b"\x6a":
        return "OP_RETURN"
    return None


# ---------- who mined it: the pool's tag in the coinbase (of the parent chain, for merge-mined blocks) ----------

POOLS = [
    ("ViaBTC", r"viabtc"), ("F2Pool", r"f2pool|七彩神仙鱼"), ("AntPool", r"antpool"), ("LitecoinPool.org", r"litecoinpool"),
    ("Binance Pool", r"binance"), ("Poolin", r"poolin"), ("Trustpool", r"trustpool"), ("Mining-Dutch", r"mining-dutch"),
    ("ZPool", r"zpool"), ("Prohashing", r"prohashing"), ("EMCDPool", r"emcd"), ("Unmineable", r"unmineable"),
    ("Hashcity", r"hashcity"), ("K1Pool", r"k1pool"), ("NiceHash", r"nicehash"), ("DxPool", r"dxpool"),
]


def pool_name(block):
    texts = []
    for tx in (block["parent_coinbase"], block["txs"][0] if block["txs"] else None):
        if tx and tx["vin"]:
            texts.append(tx["vin"][0]["script"].decode("latin-1"))
    text = " ".join(texts)
    for name, pattern in POOLS:
        if re.search(pattern, text, re.I):
            return name
    # drop the merged-mining commitment (fabe6d6d "mm" + 32-byte hash + size + nonce), then keep plain ASCII text only
    text = re.sub("\xfa\xbemm.{40}", " ", text, flags=re.S)
    tags = [t.strip("/ .-") for t in re.findall(r"[/A-Za-z0-9.\- ]{5,}", text)]
    tags = [t for t in tags if len(re.findall(r"[A-Za-z]", t)) >= 3]
    tag = max(tags, key=len) if tags else ""
    return tag[:24] if len(tag) >= 4 else "Unknown"


# ---------- blocks (cached) and the mempool ----------

_blocks = {}
_lock = threading.Lock()


def block_by_hash(h):
    with _lock:
        if h in _blocks:
            return _blocks[h]
    info = rpc("getblock", h, True)
    parsed = parse_block(rpc("getblock", h, False))
    cb = parsed["txs"][0]
    fees = max(0, sum(o["value"] for o in cb["vout"]) - SUBSIDY) if info["height"] >= 600_000 else 0
    rest = max(1, info["size"] - 80 - cb["size"])
    avg = fees / rest
    b = {"hash": h, "height": info["height"], "time": info["time"], "size": info["size"], "nTx": len(parsed["txs"]),
         "fees": fees, "avgFee": avg, "pool": pool_name(parsed), "txs": parsed["txs"], "prev": info.get("previousblockhash"),
         "next": info.get("nextblockhash"), "difficulty": info.get("difficulty"), "confirmations": info.get("confirmations"),
         "coinbaseHex": cb["vin"][0]["script"].hex()}
    with _lock:
        _blocks[h] = b
        if len(_blocks) > 300:
            for k in list(_blocks)[:100]:
                del _blocks[k]
    return b


def last_blocks(n=10):
    tip = rpc("getblockcount")
    out = []
    h = rpc("getblockhash", tip)
    while h and len(out) < n:
        b = block_by_hash(h)
        out.append(b)
        h = b["prev"]
    return out


def mempool_blocks():
    pool = rpc("getrawmempool", True)
    txs = sorted(((v["fee"] * COIN / max(1, v["size"]), v["size"], v["fee"] * COIN) for v in pool.values()), reverse=True)
    blocks, cur, size = [], [], 0
    for t in txs:
        if size + t[1] > MAX_BLOCK and cur and len(blocks) < 7:
            blocks.append((cur, size))
            cur, size = [], 0
        cur.append(t)
        size += t[1]
    if cur or not blocks:
        blocks.append((cur, size))
    out = []
    for cur, size in blocks[:8]:
        rates = sorted(t[0] for t in cur)
        pick = lambda q: round(rates[min(len(rates) - 1, int(q * len(rates)))], 2) if rates else 0
        out.append({"blockSize": size, "blockVSize": size, "nTx": len(cur), "totalFees": round(sum(t[2] for t in cur)),
                    "medianFee": pick(0.5), "feeRange": [pick(0), pick(0.1), pick(0.25), pick(0.5), pick(0.75), pick(0.9), round(rates[-1], 2) if rates else 0]})
    return out


def mempool_json(b):
    """a block in mempool.space's /api/v1/blocks format"""
    r = round(b["avgFee"], 2)
    return {"id": b["hash"], "height": b["height"], "timestamp": b["time"], "tx_count": b["nTx"], "size": b["size"], "weight": b["size"] * 4,
            "previousblockhash": b["prev"], "extras": {"medianFee": r, "feeRange": [r, r], "totalFees": b["fees"], "reward": b["fees"] + SUBSIDY,
                                                      "pool": {"name": b["pool"]}, "coinbaseRaw": b["coinbaseHex"]}}


# ---------- mining statistics from your own node (mempool.space's /api/v1/mining format) ----------

DAY, WEEK, YEAR_DAYS = 1440, 10080, 365  # Dogecoin: a block a minute
_pool_by_height = {}
_mining = {"hashrate": None, "pools": None, "at": 0}


def pool_from_header(header_hex):
    """the pool tag, from a block header: merge-mined headers carry the parent chain's coinbase (AuxPoW)"""
    r = Reader(bytes.fromhex(header_hex))
    version = r.i32()
    r.take(76)
    if version & 0x100 and r.i < len(r.d):
        return pool_name({"parent_coinbase": read_tx(r), "txs": []})
    return None


def pools_last_week(tip):
    first = max(0, tip - WEEK + 1)
    todo = [h for h in range(first, tip + 1) if h not in _pool_by_height]
    for i in range(0, len(todo), 250):
        chunk = todo[i:i + 250]
        pairs = [(h, bh) for h, bh in zip(chunk, rpc_batch([("getblockhash", [h]) for h in chunk])) if bh]
        headers = rpc_batch([("getblockheader", [bh, False]) for _, bh in pairs])
        for (h, bh), hx in zip(pairs, headers):
            name = None
            try:
                name = pool_from_header(hx) if hx else None
                if name is None:  # not merge-mined: the pool tag is in the block's own coinbase
                    name = pool_name(parse_block(rpc("getblock", bh, False)))
            except (ValueError, RpcError, KeyError, IndexError):
                name = "Unknown"
            _pool_by_height[h] = name
    for h in [h for h in _pool_by_height if h < first]:
        del _pool_by_height[h]
    counts = {}
    for h in range(first, tip + 1):
        if h in _pool_by_height:
            counts[_pool_by_height[h]] = counts.get(_pool_by_height[h], 0) + 1
    ranked = sorted(counts.items(), key=lambda kv: -kv[1])
    total = sum(counts.values())
    return {"pools": [{"poolId": i + 1, "name": n, "slug": re.sub(r"[^a-z0-9]", "", n.lower()), "rank": i + 1, "blockCount": c, "emptyBlocks": 0}
                      for i, (n, c) in enumerate(ranked)],
            "blockCount": total, "lastEstimatedHashrate": rpc("getnetworkhashps", DAY)}


def hashrate_year(tip):
    heights = [tip - d * DAY for d in range(YEAR_DAYS) if tip - d * DAY > DAY][::-1]
    hashes = rpc_batch([("getblockhash", [h]) for h in heights])
    headers = rpc_batch([("getblockheader", [bh]) for bh in hashes if bh])
    rates = rpc_batch([("getnetworkhashps", [DAY, h]) for h in heights])
    by_height = {hd["height"]: hd for hd in headers if hd}
    points, diffs, prev = [], [], None
    for h, rate in zip(heights, rates):
        hd = by_height.get(h)
        if not hd or rate is None:
            continue
        points.append({"timestamp": hd["time"], "avgHashrate": rate})
        d = hd["difficulty"]
        diffs.append({"time": hd["time"], "height": h, "difficulty": d, "adjustment": (d / prev) if prev else 1})
        prev = d
    return {"hashrates": points, "difficulty": diffs, "currentHashrate": rpc("getnetworkhashps", WEEK), "currentDifficulty": rpc("getdifficulty")}


def mining_stats():
    """recomputed every 10 minutes in the background (the first run reads a week of block headers)"""
    while True:
        try:
            tip = rpc("getblockcount")
            _mining["pools"] = pools_last_week(tip)
            _mining["hashrate"] = hashrate_year(tip)
            _mining["at"] = time.time()
        except Exception as exc:  # noqa: BLE001
            log("mining stats: " + str(exc))
        time.sleep(600)


# ---------- WebSocket (mempool.space protocol) ----------

_clients = set()
_clients_lock = threading.Lock()
_state = {"tip": None, "mempool": [], "mempool_json": ""}
_send_lock = threading.Lock()


def ws_send(sock, text):
    data = text.encode()
    head = bytearray([0x81])
    if len(data) < 126:
        head.append(len(data))
    elif len(data) < 65536:
        head += bytes([126]) + struct.pack(">H", len(data))
    else:
        head += bytes([127]) + struct.pack(">Q", len(data))
    with _send_lock:
        sock.sendall(bytes(head) + data)


def broadcast(obj):
    text = json.dumps(obj)
    with _clients_lock:
        dead = []
        for c in _clients:
            try:
                ws_send(c, text)
            except OSError:
                dead.append(c)
        for c in dead:
            _clients.discard(c)


def poller():
    while True:
        try:
            tip = rpc("getbestblockhash")
            if tip != _state["tip"]:
                first = _state["tip"] is None
                _state["tip"] = tip
                if not first:
                    broadcast({"block": mempool_json(block_by_hash(tip))})
            mp = mempool_blocks()
            text = json.dumps(mp)
            if text != _state["mempool_json"]:
                _state["mempool"], _state["mempool_json"] = mp, text
                broadcast({"mempool-blocks": mp})
        except Exception as exc:  # noqa: BLE001
            log("poll: " + str(exc))
        time.sleep(6)


