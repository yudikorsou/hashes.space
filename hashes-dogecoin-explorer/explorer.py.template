if(j.utxos.length){document.getElementById('wutxo').hidden=false;document.getElementById('wrows').innerHTML=j.utxos.map(function(u){return '<tr><td class=mono><a href="/tx/'+u.txid+'">'+u.txid.slice(0,16)+'…'+u.txid.slice(-6)+'</a></td><td class=r>'+u.vout+'</td><td class=r>'+(u.height||'')+'</td><td class=r>'+fmt(u.value)+'</td></tr>'}).join('')}
}).catch(function(){bar.hidden=true;amt.innerHTML='<span class=err>The explorer could not be reached</span>';sub.textContent=''});
var c=document.querySelector('.vcopy');if(c)c.onclick=function(){try{navigator.clipboard.writeText(a);c.textContent='Copied';setTimeout(function(){c.textContent='Copy'},1500)}catch(e){}}})();"""


def wallet_html(a):
    v = VERIFIED.get(a)
    head = ("<p class=wver><span class=vbig>✔ Verified</span> · " + html.escape(v["name"]) + " <em class=ftag>" + html.escape(v["category"]) + " · accepts DOGE donations</em></p>") if v else ""
    about = ""
