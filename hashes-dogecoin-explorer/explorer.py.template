             + st("2", "Add the best-paying transactions", "the ones <a href='/fee-sorting'>fee sorting</a> picked, in that order",
                  "<div class=big2>" + "{:,}".format(n - 1) + " <small>transactions</small></div><div class=sub>" + "{:,.1f}".format(t["size"] / 1000.0) + " kB · fees " + doge(t["fees"]) + "</div>", "s2")
             + st("3", "Hash them in pairs", "each id twice through SHA-256, two by two, until one is left",
                  "<div class=big2>" + "{:,}".format(n) + " hashes → 1</div><div class=sub>" + str(t["rounds"]) + " round" + ("" if t["rounds"] == 1 else "s") + (" · a lone hash is paired with itself" if n > 1 else "") + "</div>", "s3")
