def page(title, body):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>" + html.escape(title) + " · Dogecoin explorer</title><style>" + CSS + "</style></head><body>"
            "<header><a class=brand href='/'>Dogecoin <span>explorer</span></a>"
            "<form action='/search'><input name=q placeholder='Block height, block hash or transaction id' aria-label=Search>"
            "<button>Search</button></form></header><main>" + body + "</main>"
            "<footer>Read from your own Dogecoin Core node · hashes.space</footer></body></html>")


def doge(koinu):
    return "{:,.8f}".format(koinu / COIN).rstrip("0").rstrip(".") + " DOGE"


def ago(t):
    s = max(0, int(time.time() - t))
    return str(s) + "s ago" if s < 60 else str(s // 60) + "m ago" if s < 3600 else str(s // 3600) + "h ago" if s < 86400 else str(s // 86400) + "d ago"


def home():
    info = rpc("getblockchaininfo")
    mp = rpc("getmempoolinfo")
    blocks = last_blocks(15)
    rows = "".join(
        "<tr><td><a href='/block/" + b["hash"] + "'>" + "{:,}".format(b["height"]) + "</a></td><td class=muted>" + ago(b["time"]) + "</td><td>"
        + html.escape(b["pool"]) + "</td><td class=r>" + str(b["nTx"]) + "</td><td class=r>" + "{:,.1f}".format(b["size"] / 1000) + " kB</td><td class=r>"
        + doge(b["fees"]) + "</td></tr>" for b in blocks)
    projected = _state["mempool"] or mempool_blocks()
    prow = "".join("<tr><td>" + ("Next block" if i == 0 else "+" + str(i)) + "</td><td class=r>" + str(p["nTx"]) + "</td><td class=r>"
                   + "{:,.1f}".format(p["blockSize"] / 1000) + " kB</td><td class=r>~" + str(p["medianFee"]) + " koinu/B</td></tr>"
                   for i, p in enumerate(projected))
    sync = info.get("verificationprogress", 0)
    return page("Dogecoin", "<h1>Dogecoin</h1><div class=stats>"
                + "".join("<div class='card stat'><span class=muted>" + k + "</span><b>" + v + "</b></div>" for k, v in [
                    ("Block height", "{:,}".format(info["blocks"])), ("Mempool", "{:,} txs".format(mp["size"])),
                    ("Mempool size", "{:,.1f} kB".format(mp["bytes"] / 1000)), ("Node sync", "{:.2f}%".format(sync * 100))])
                + "</div><section class=card><h2>Latest blocks</h2><table><tr><th>Height</th><th>Mined</th><th>Pool</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Fees</th></tr>"
                + rows + "</table></section><section class=card><h2>Mempool, in blocks of 1 MB</h2><table><tr><th>Block</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th></tr>"
                + prow + "</table></section>")


def block_page(ident):
    h = rpc("getblockhash", int(ident)) if ident.isdigit() else ident
    b = block_by_hash(h)
    nav = ("<a href='/block/" + b["prev"] + "'>← previous</a>" if b["prev"] else "") + ("  ·  <a href='/block/" + b["next"] + "'>next →</a>" if b["next"] else "")
    rows = ""
    for tx in b["txs"][:1000]:
        outs = ", ".join(html.escape(address(o["script"]) or "?") for o in tx["vout"][:3]) + (" …" if len(tx["vout"]) > 3 else "")
        rows += ("<tr><td class=mono><a href='/tx/" + tx["txid"] + "?b=" + h + "'>" + tx["txid"][:16] + "…</a></td><td>" + ("coinbase" if tx["coinbase"] else str(len(tx["vin"])) + " in")
                 + "</td><td class='mono wrap'>" + outs + "</td><td class=r>" + doge(sum(o["value"] for o in tx["vout"])) + "</td></tr>")
    more = "<p class=muted>Showing the first 1,000 of " + "{:,}".format(b["nTx"]) + " transactions.</p>" if b["nTx"] > 1000 else ""
    return page("Block " + str(b["height"]), "<h1>Block " + "{:,}".format(b["height"]) + "</h1><p>" + nav + "</p><section class=card><dl>"
                + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in [
                    ("Hash", "<span class=mono>" + h + "</span>"), ("Mined", time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(b["time"])) + " (" + ago(b["time"]) + ")"),
                    ("Pool", html.escape(b["pool"])), ("Transactions", "{:,}".format(b["nTx"])), ("Size", "{:,} bytes".format(b["size"])),
                    ("Fees", doge(b["fees"]) + " (~" + "{:.2f}".format(b["avgFee"]) + " koinu/B)"), ("Reward", doge(b["fees"] + SUBSIDY)),
                    ("Difficulty", "{:,.0f}".format(b["difficulty"] or 0)), ("Confirmations", "{:,}".format(b["confirmations"] or 0))])
                + "</dl></section><section class=card><h2>Transactions</h2><table><tr><th>Txid</th><th>Inputs</th><th>To</th><th class=r>Value</th></tr>"
                + rows + "</table>" + more + "</section>")


def find_tx(txid, block_hash):
    try:
        v = rpc("getrawtransaction", txid, 1)
        tx = read_tx(Reader(bytes.fromhex(v["hex"])))
        return tx, v.get("blockhash"), v.get("confirmations", 0)
    except RpcError:
        if not block_hash:
            raise RpcError("Transaction not in the mempool. Open it from its block, or run Dogecoin Core with -txindex=1 to look up any transaction.")
        b = block_by_hash(block_hash)
        for tx in b["txs"]:
            if tx["txid"] == txid:
                return tx, block_hash, b["confirmations"]
        raise RpcError("Transaction not found in that block.")


def tx_page(txid, block_hash):
    tx, bh, conf = find_tx(txid, block_hash)
    ins = "".join("<tr><td class='mono wrap'>" + ("coinbase" if tx["coinbase"] else "<a href='/tx/" + i["prev"] + "'>" + i["prev"][:16] + "…</a>:" + str(i["n"])) + "</td></tr>" for i in tx["vin"])
    outs = "".join("<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + html.escape(address(o["script"]) or o["script"].hex()[:60]) + "</td><td class=r>" + doge(o["value"]) + "</td></tr>"
                   for n, o in enumerate(tx["vout"]))
    return page("Transaction", "<h1>Transaction</h1><section class=card><dl>"
                + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in [
                    ("Txid", "<span class=mono>" + tx["txid"] + "</span>"), ("Status", ("In block <a href='/block/" + bh + "'>" + bh[:16] + "…</a> · " + "{:,}".format(conf) + " confirmations") if bh else "In the mempool, waiting for a block"),
                    ("Size", "{:,} bytes".format(tx["size"])), ("Total out", doge(sum(o["value"] for o in tx["vout"])))])
                + "</dl></section><section class=card><h2>Inputs</h2><table>" + ins + "</table></section><section class=card><h2>Outputs</h2><table><tr><th>#</th><th>Address</th><th class=r>Value</th></tr>"
                + outs + "</table></section>")


class Handler(BaseHTTPRequestHandler):
    server_version = "dogecoin-explorer"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", cache=0):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(cache) if cache else "no-store")
        self.end_headers()
        self.wfile.write(data)

    def json(self, obj, cache=0):
        self.send(200, json.dumps(obj), "application/json", cache)

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        params = dict(p.split("=", 1) for p in query.split("&") if "=" in p)
        try:
            if path == "/api/v1/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
                return self.websocket()
            if path == "/api/v1/blocks":
                return self.json([mempool_json(b) for b in last_blocks(10)], 10)
            if path == "/api/v1/fees/mempool-blocks":
                return self.json(_state["mempool"] or mempool_blocks(), 5)
            if path in ("/api/v1/mining/hashrate/1y", "/api/v1/mining/pools/1w"):
                data = _mining["hashrate" if "hashrate" in path else "pools"]
                if data is None:
                    return self.send(503, json.dumps({"error": "Mining statistics are being computed from your node, try again in a minute"}), "application/json")
                return self.json(data, 300)
            if path == "/api/blocks/tip/height":
                return self.send(200, str(rpc("getblockcount")), "text/plain", 5)
            if path == "/":
                return self.send(200, home())
            if path.startswith("/block/"):
                return self.send(200, block_page(path[7:]))
            if path.startswith("/tx/") and HEX64.fullmatch(path[4:]):
                return self.send(200, tx_page(path[4:].lower(), params.get("b")))
            if path == "/search":
                q = urllib.request.unquote(params.get("q", "").replace("+", " ")).strip()
                if q.isdigit():
                    return self.redirect("/block/" + q)
                if HEX64.fullmatch(q):
                    try:
                        rpc("getblockheader", q)
                        return self.redirect("/block/" + q)
                    except RpcError:
                        return self.redirect("/tx/" + q.lower())
                return self.send(404, page("Not found", "<h1>Nothing found</h1><p>Search for a block height, a block hash or a transaction id.</p>"))
            return self.send(404, page("Not found", "<h1>Not found</h1>"))
        except (RpcError, ValueError) as exc:
            if path.startswith("/api/"):
                return self.send(502, json.dumps({"error": str(exc)}), "application/json")
            return self.send(502, page("Error", "<h1>Something went wrong</h1><p class=err>" + html.escape(str(exc)) + "</p>"))

    def redirect(self, to):
        self.send_response(302)
        self.send_header("Location", to)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def websocket(self):
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        sock = self.connection
        sock.settimeout(120)
        try:
            while True:
                head = self.rfile.read(2)
                if len(head) < 2:
                    break
                op, ln = head[0] & 0x0F, head[1] & 0x7F
                if ln == 126:
                    ln = struct.unpack(">H", self.rfile.read(2))[0]
                elif ln == 127:
                    ln = struct.unpack(">Q", self.rfile.read(8))[0]
                mask = self.rfile.read(4) if head[1] & 0x80 else b"\0\0\0\0"
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(self.rfile.read(ln)))
                if op == 8:
                    break
                if op == 9:
                    with _send_lock:
                        sock.sendall(bytes([0x8A, len(data)]) + data)
                    continue
                if op != 1:
                    continue
                try:
                    msg = json.loads(data)
                except ValueError:
                    continue
                if msg.get("action") == "want":
                    with _clients_lock:
                        _clients.add(sock)
                    ws_send(sock, json.dumps({"blocks": [mempool_json(b) for b in last_blocks(8)], "mempool-blocks": _state["mempool"] or mempool_blocks()}))
                elif msg.get("action") == "ping":
                    ws_send(sock, json.dumps({"pong": True}))
        except (OSError, RpcError, ValueError):
            pass
        finally:
            with _clients_lock:
                _clients.discard(sock)
            self.close_connection = True


def main():
    threading.Thread(target=poller, daemon=True).start()
    threading.Thread(target=mining_stats, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.daemon_threads = True
    log("listening on port " + str(PORT))
    server.serve_forever()


if __name__ == "__main__":
    main()
