function esc(x){var d=document.createElement('div');d.textContent=x;return d.innerHTML}
fetch('/api/v1/address/'+a).then(function(r){return r.json().then(function(j){return{ok:r.ok,j:j}})}).then(function(x){bar.hidden=true;
if(!x.ok){amt.innerHTML='<span class=err>'+esc(x.j.error||'Could not read the balance')+'</span>';sub.textContent='';return}
