_bal = {}
_scan_lock = threading.Lock()


def address_balance(a):
    """{"total": koinu, "utxos": [...]} from the node's UTXO set (scantxoutset, no address index needed); cached for two minutes.
    Raises RpcError when the node cannot scan (older Dogecoin Core) or is busy."""
    hit = _bal.get(a)
    if hit and time.time() - hit[0] < 120:
        return hit[1]
    if not _scan_lock.acquire(timeout=240):
        raise RpcError("The node is busy scanning another address. Try again in a moment.")
    try:
        hit = _bal.get(a)
        if hit and time.time() - hit[0] < 120:
            return hit[1]
        try:
            r = rpc("scantxoutset", "start", ["addr(" + a + ")"], timeout=600)
        except RpcError as exc:
            if "not found" in str(exc).lower():
                raise RpcError("This version of Dogecoin Core cannot look up the balance of an address (no scantxoutset).")
            raise
        if not isinstance(r, dict) or r.get("success") is False:
            raise RpcError("The node could not finish the scan. Try again in a moment.")
        us = sorted(({"txid": u["txid"], "vout": u["vout"], "value": int(round(float(u["amount"]) * COIN)), "height": u.get("height")} for u in r.get("unspents", [])),
                    key=lambda u: -(u["height"] or 0))
        out = {"address": a, "total": sum(u["value"] for u in us), "count": len(us), "height": r.get("height"), "utxos": us[:200], "shown": min(len(us), 200)}
        if len(_bal) > 300:
            _bal.clear()
        _bal[a] = (time.time(), out)
        return out
    finally:
        _scan_lock.release()


