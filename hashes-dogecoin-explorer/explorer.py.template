    short5 = lambda h: h[:5]
    mk = {"n": n, "leaves": [short5(x) for x in t["leaves"]], "l1": [short5(x) for x in t["l1"]], "root": t["root"][:8]}
    leaves = ["<tr class=miner><td class=n>0</td><td><span class=tag>coinbase</span> <span class=mono>" + short(t["cb"], 10, 6) + "</span></td><td class=r>—</td><td class=r>" + doge(t["reward"]) + "</td></tr>"]
    for i, x in enumerate(t["txs"][:200]):
