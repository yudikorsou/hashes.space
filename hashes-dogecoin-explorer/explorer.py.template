    steps = (st("1", "Pick the transactions", "the best fee per byte that fit the block · <a href='/fee-sorting'>fee sorting</a>",
                "<div class=big2>" + "{:,}".format(n) + " <small>transactions</small></div><div class=fill><i style='width:" + "{:.0f}".format(min(100, t["size"] / t["limit"] * 100)) + "%'></i></div>"
                "<div class=sub>" + "{:,.1f}".format(t["size"] / 1000.0) + " kB of " + "{:,}".format(t["limit"]) + " B · fees " + doge(t["fees"]) + "</div>", "s1")
             + st("2", "Fold them into a merkle root", "<a href='/coinbase-merkle'>coinbase &amp; merkle root</a> · " + "{:,}".format(t["nleaves"]) + " hashes, " + str(t["rounds"]) + " rounds",
                  "<div class='big2 mono'>" + short(t["root"], 12, 8) + "</div><div class=sub>" + "{:,}".format(t["nleaves"]) + " hashes → 1 root</div>", "s2")
             + st("3", "Add the coinbase", "pays whoever finds the block: the flat subsidy plus every fee",
                  "<div class=big2>" + "{:,.2f}".format(t["reward"] / COIN) + " <small>DOGE</small></div><div class=sub>" + "{:,}".format(SUBSIDY // COIN) + " subsidy + " + doge(t["fees"]) + " fees</div>", "s3")
             + st("4", "Write the 80-byte header", "what every miner hashes, over and over, with a new nonce each time",
                  bar + legend, "s4"))
    rows = [("Version", 4, "0", "0x{:08x}".format(t["version"] & 0xFFFFFFFF) + " (" + "{:,}".format(t["version"]) + "): bit 8 flags a merge-mined (AuxPoW) block, the top 16 bits are Dogecoin's chain id 0x0062", HDR[0][2], t["hdr"][0:8]),
            ("Previous block", 32, "4", "hash of block " + "{:,}".format(t["height"] - 1) + ", the block this one builds on", HDR[1][2], t["hdr"][8:72]),
            ("Merkle root", 32, "36", "one hash of the coinbase and all " + "{:,}".format(n) + " transactions", HDR[2][2], t["hdr"][72:136]),
            ("Time", 4, "68", time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(t["time"])) + ": the miner may move it on while hashing", HDR[3][2], t["hdr"][136:144]),
            ("Bits", 4, "72", "the target a hash must fall under" + ("" if t["bitsExact"] else " (the previous block's: your node sets it afresh for every block, so it moves a little)"), HDR[4][2], t["hdr"][144:152]),
            ("Nonce", 4, "76", "0 here: the search through the nonce is the <a href='/block-candidate'>candidate block</a>", HDR[5][2], t["hdr"][152:160])]
    trs = "".join("<tr><td class=sw><i style='background:" + c + "'></i></td><td>" + k + "</td><td class=r>" + str(sz) + "</td><td class=r data-b='" + b + "'>" + b + "</td><td class=why>" + why + "</td><td class='mono wrap'>" + hx + "</td></tr>" for k, sz, b, why, c, hx in rows)
    colored = "".join("<span style='color:" + c + "'>" + hx + "</span>" for _, _, _, _, c, hx in rows)
    details = ("<details><summary>The header, field by field</summary><div class=tbl><table class='rank fld'><tr><th></th><th>Field</th><th class=r>Bytes</th><th class=r>From byte</th><th>What it is</th><th>Value (hex)</th></tr>" + trs + "</table></div>"
               "<div class='hexblob mono'>" + colored + "</div></details>")
    return {"chips": chips, "steps": steps, "details": details, "height": t["height"], "root": t["root"], "ntx": n, "prev": t["prev"], "weight": t["size"], "limit": t["limit"], "reward": t["reward"] / COIN,
            "ver": "0x{:08x}".format(t["version"] & 0xFFFFFFFF), "bits": t["bits"], "time": t["time"], "segs": [[sz, c] for _, sz, c in HDR], "total": 80}


