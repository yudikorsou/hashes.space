# ---------- the block your node would build: the pages the Find Mempool page opens from the four blocks of the Dogecoin chain ----------
# /fee-sorting, /coinbase-merkle, /block-assembly and /block-candidate (each also as .json), all from the node's own getblocktemplate (or, when the
# node will not give one, from its mempool, cut the way the template is: best fee per byte first, parents before children, up to the size limit)

BLOCK_SECONDS = 60
_tpl = {"at": 0.0, "v": None}


def merkle_root(ids):
    """the merkle root of 32-byte hashes (internal order), and the number of rounds it takes: pairs are hashed twice with SHA-256, an odd one out is paired with itself"""
    level, rounds = list(ids), 0
    while len(level) > 1:
        if len(level) % 2:
            level.append(level[-1])
        level = [sha256d(level[i] + level[i + 1]) for i in range(0, len(level), 2)]
        rounds += 1
    return level[0], rounds


def pick_txs(rows, pool, limit):
    """what the node puts in a block: best fee rate first, a parent before its child, until the block is full (1,000 bytes are kept for the coinbase)"""
    chosen, ids, size, pending, moved = [], set(), 1000, rows, True
    while pending and moved:
        moved, later = False, []
        for r in pending:
            if any(d in pool and d not in ids for d in pool[r[1]].get("depends", [])):
                later.append(r)
                continue
            if size + r[2] > limit:
                continue
            chosen.append(r)
            ids.add(r[1])
            size += r[2]
            moved = True
        pending = later
    return chosen


def doge_template():
    """everything the four pages show, from your node (cached for 8 seconds)"""
    with _lock:
        if _tpl["v"] and time.time() - _tpl["at"] < 8:
            return _tpl["v"]
    best = rpc("getbestblockhash")
    hd = rpc("getblockheader", best)
    height = hd["height"] + 1
    pool = rpc("getrawmempool", True)
    try:
        mpi = rpc("getmempoolinfo")
    except RpcError:
        mpi = {}
    try:
        gbt = rpc("getblocktemplate", {})
    except RpcError:
        gbt = None
    rows = sorted(((v["fee"] * COIN / max(1, v["size"]), k, v["size"], round(v["fee"] * COIN)) for k, v in pool.items()), key=lambda r: r[0], reverse=True)
    limit = int(gbt.get("sizelimit") or MAX_BLOCK) if gbt else MAX_BLOCK
    if gbt and isinstance(gbt.get("transactions"), list):
        txs = [(t.get("txid") or t["hash"], len(t["data"]) // 2, int(t.get("fee") or 0)) for t in gbt["transactions"]]
        source = "the block template of your node"
    else:
        txs = [(r[1], r[2], r[3]) for r in pick_txs(rows, pool, limit)]
        source = "your node's mempool"
    fees = sum(t[2] for t in txs)
    cb = sha256d(("coinbase|" + str(height) + "|hashes.space").encode())     # stand-in: the real coinbase only exists when a miner builds it
    leaves = [cb] + [bytes.fromhex(t[0])[::-1] for t in txs]
    root, rounds = merkle_root(leaves)
    version = int(gbt["version"]) if gbt else int(hd["version"])
    prev = gbt["previousblockhash"] if gbt else best
    bits = gbt["bits"] if gbt else hd["bits"]
    now = int(gbt["curtime"]) if gbt else int(time.time())
    header = (version & 0xFFFFFFFF).to_bytes(4, "little") + bytes.fromhex(prev)[::-1] + root + now.to_bytes(4, "little") + bytes.fromhex(bits)[::-1] + b"\0\0\0\0"
    mr = mpi.get("mempoolminfee") or mpi.get("minrelaytxfee")
    v = {"height": height, "version": version, "prev": prev, "bits": bits, "bitsExact": bool(gbt), "time": now, "last": int(hd["time"]), "diff": float(hd["difficulty"]),
         "txs": txs, "size": sum(t[1] for t in txs), "fees": fees, "reward": int(gbt["coinbasevalue"]) if gbt and gbt.get("coinbasevalue") else SUBSIDY + fees,
         "root": root[::-1].hex(), "cb": cb[::-1].hex(), "leaves": [x[::-1].hex() for x in leaves[:4]], "nleaves": len(leaves), "rounds": rounds,
         "l1": [sha256d(leaves[i] + (leaves[i + 1] if i + 1 < len(leaves) else leaves[i]))[::-1].hex() for i in (0, 2) if i < len(leaves) and len(leaves) > 1], "hdr": header.hex(), "rows": rows, "waiting": len(pool),
         "poolBytes": int(mpi.get("bytes") or sum(r[2] for r in rows)), "limit": limit, "source": source, "minrelay": (float(mr) * COIN / 1000.0) if mr else None}
    with _lock:
        _tpl["v"], _tpl["at"] = v, time.time()
    return v


def esc(s):
    return html.escape(str(s), quote=True)


def hashrate_text(h):
    for u in ("H/s", "kH/s", "MH/s", "GH/s", "TH/s", "PH/s", "EH/s"):
        if h < 1000 or u == "EH/s":
            return "{:,.2f}".format(h) if h < 100 else "{:,.0f}".format(h), u
