#!/usr/bin/env python3
"""Monero Explorer front: the explorer itself, plus mining statistics from your own node.

The Onion Monero Blockchain Explorer (xmrblocks) answers every request it knows (its pages and
its /api/... JSON). This small server stands in front of it on the app's port, hands everything
on to it unchanged, and adds the two endpoints the hashes.space Find Mempool page reads for its
"Global hashrate" and "Mining pools" sections, in mempool's shape:

  /api/v1/mining/hashrate/<period>   hashrate and difficulty over the period
  /api/v1/mining/pools/<period>      how the period's blocks were paid out
  /api/v1/mining/pool-hashrate/<period>  the hashrate of the P2Pool miners (the only pool whose blocks the chain shows): network hashrate times the share of P2Pool blocks
  (period: 24h, 14d, 1m, 6m or 1y; 1w is still answered for older versions of the page)

so the page gets those graphs from the same Monero Explorer that streams the blocks
(xmr.hashes.space), computed from the Monero Node app on this Umbrel.

A note on Monero and pool names. On Bitcoin every block says who mined it: the pool writes its
name into the coinbase. Monero blocks say nothing of the sort - the reward goes to a one-time
address that reveals nothing - so no node can tell you "F2Pool mined this block". What the chain
does show is how a block's reward was split. P2Pool, the decentralised pool, pays every one of its
miners directly in the block's own coinbase, so its blocks carry many payouts; a block from a
custodial pool (or from a solo miner) carries a single payout. That split is what is shown.
"""

import hashlib
import http.client
import http.server
import json
import os
import re
import secrets
import socketserver
import threading
import time

PORT = int(os.environ.get("PORT", "3000"))
EXPLORER_HOST = os.environ.get("EXPLORER_HOST", "explorer")
EXPLORER_PORT = int(os.environ.get("EXPLORER_PORT", "8081"))

NODE = os.environ.get("MONERO_HOST", "")
NODE_PORT = os.environ.get("MONERO_RPC_PORT", "18081")
LOGIN = os.environ.get("MONERO_RPC_AUTH", "")  # user:password, from the Monero Node app

BLOCK_SECONDS = 120          # Monero's target block time: hashrate = difficulty / 120
DAY = 86400
WEEK = 7 * DAY
YEAR = 365 * DAY
BLOCKS_PER_DAY = DAY // BLOCK_SECONDS


def log(*a):
    print("[stats]", *a, flush=True)


# ---------- the Monero node ----------

class Node:
    """Talks to monerod over HTTP digest auth.

    monerod ties its digest nonce to the TCP connection, so a fresh connection per request is
    answered with 401 forever. This keeps one connection open, does the challenge once on it and
    reuses it; if the node closes it, the next call reconnects and challenges again."""

    def __init__(self, host, port, login):
        self.host, self.port = host, int(port)
        self.user, _, self.password = login.partition(":")
        self.conn, self.chal, self.nc = None, None, 0
        self.lock = threading.Lock()

    @staticmethod
    def _parse(header):
        # monerod offers MD5 and MD5-sess in one header; the first (MD5) is the one we answer
        first = header.split(", Digest")[0]
        return dict((m[0].lower(), m[1].strip('"')) for m in re.findall(r'(\w+)=("[^"]*"|[^,]*)', first))

    def _authorization(self, path):
        c = self.chal
        self.nc += 1
        nc, cnonce = "{:08x}".format(self.nc), secrets.token_hex(8)
        md5 = lambda text: hashlib.md5(text.encode()).hexdigest()
        ha1 = md5(self.user + ":" + c.get("realm", "") + ":" + self.password)
        ha2 = md5("POST:" + path)
        resp = md5(ha1 + ":" + c.get("nonce", "") + ":" + nc + ":" + cnonce + ":auth:" + ha2)
        return ('Digest username="' + self.user + '", realm="' + c.get("realm", "") + '", nonce="'
                + c.get("nonce", "") + '", uri="' + path + '", algorithm=MD5, qop=auth, nc=' + nc
                + ', cnonce="' + cnonce + '", response="' + resp + '"')

    def _send(self, path, body, timeout):
        headers = {"Content-Type": "application/json", "Connection": "keep-alive"}
        if self.chal and self.password:
            headers["Authorization"] = self._authorization(path)
        self.conn.timeout = timeout
        self.conn.request("POST", path, body=body, headers=headers)
        r = self.conn.getresponse()
        data = r.read()
        return r.status, r.getheader("WWW-Authenticate") or r.getheader("WWW-authenticate") or "", data

    def post(self, path, body, timeout):
        with self.lock:
            for attempt in (1, 2, 3):
                try:
                    if self.conn is None:
                        self.conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
                        self.chal, self.nc = None, 0
                    status, challenge, data = self._send(path, body, timeout)
                except (http.client.HTTPException, OSError):
                    self._drop()
                    if attempt == 3:
                        raise
                    continue
                if status == 401 and challenge.lower().startswith("digest") and self.password:
                    self.chal, self.nc = self._parse(challenge), 0
                    continue
                if status != 200:
                    raise RuntimeError("the Monero node answered HTTP " + str(status))
                return json.loads(data)
        raise RuntimeError("the Monero node would not authenticate")

    def _drop(self):
        try:
            if self.conn:
                self.conn.close()
        except Exception:
            pass
        self.conn, self.chal, self.nc = None, None, 0


NODE_RPC = Node(NODE, NODE_PORT, LOGIN)


def rpc(method, params=None, timeout=20):
    body = json.dumps({"jsonrpc": "2.0", "id": "0", "method": method, "params": params or {}}).encode()
    out = NODE_RPC.post("/json_rpc", body, timeout)
    if "error" in out:
        raise RuntimeError(str(out["error"]))
    return out["result"]


def payouts_in(height):
    """How many miners this block paid directly. P2Pool pays all of its miners in the block's
    own coinbase, so its blocks have many outputs; everything else has one."""
    block = rpc("get_block", {"height": height})
    miner = json.loads(block["json"])["miner_tx"]
    return max(1, len(miner.get("vout") or []))


# ---------- the periods the page offers ----------
# blocks in the period, and one hashrate point per STEP blocks (a block every 2 minutes). "1w" is what older
# versions of the page ask for.
RANGES = {"24h": (720, 30), "1w": (5040, 60), "14d": (10080, 180), "1m": (21600, 360), "6m": (129600, 1440), "1y": (262800, 1440)}
SAMPLE = 2500   # a long period reads about this many blocks for its payout split (an estimate); a short one reads them all

_lock = threading.Lock()
_headers = {}    # height -> (timestamp, difficulty)
_payouts = {}    # height -> how many outputs its coinbase pays
_result = {"hashrate": {}, "pools": {}, "pool-hashrate": {}, "info": None}


def header_at(height):
    if height not in _headers:
        hd = rpc("get_block_header_by_height", {"height": height})["block_header"]
        _headers[height] = (int(hd["timestamp"]), int(hd["difficulty"]))
    return _headers[height]


def hashrate_range(tip, info, rng):
    blocks, step = RANGES[rng]
    heights = [tip - d * step for d in range(blocks // step) if tip - d * step > 1][::-1]
    points = []
    for h in heights:
        try:
            points.append(header_at(h))
        except Exception as exc:
            log("header " + str(h) + ": " + str(exc))
    now = int(info["difficulty"])
    return {"currentHashrate": now / BLOCK_SECONDS, "currentDifficulty": now,
            "hashrates": [{"timestamp": t, "avgHashrate": d / BLOCK_SECONDS} for t, d in points],
            "difficulty": [{"time": t, "difficulty": d} for t, d in points]}


def pools_range(tip, rng):
    """the payout split of one period: every block of a short one, an evenly spread sample of a long one (scaled up)"""
    blocks = RANGES[rng][0]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    heights = [h for h in range(first, tip + 1) if h % stride == 0]
    for h in heights:
        if h not in _payouts:
            try:
                _payouts[h] = payouts_in(h)
            except Exception as exc:          # one unreadable block must not sink the whole period
                log("block " + str(h) + ": " + str(exc))
    seen = [_payouts[h] for h in heights if h in _payouts]
    if not seen:
        raise RuntimeError("no data yet")
    scale = (tip - first + 1) / len(seen)     # 1 when every block was read
    shared = sum(1 for o in seen if o > 1)
    payouts = sum(o for o in seen if o > 1)
    pools = []
    if shared:
        n = max(1, round(shared * scale))
        pools.append({"name": "P2Pool", "blockCount": n,
                      "miners": [{"name": str(round(payouts / shared)) + " miners paid per block", "blockCount": n}]})
    single = len(seen) - shared
    if single:
        pools.append({"name": "Single payout (pool or solo miner)", "blockCount": max(1, round(single * scale))})
    return {"blockCount": tip - first + 1, "sampled": stride > 1, "pools": pools}


def pool_hashrate_range(tip, rng, hr):
    """Monero names no pool, but P2Pool pays all of its miners in the block itself, so its blocks can be told apart: the hashrate of
    those miners is the network's hashrate times the share of P2Pool blocks around each point (all blocks read for a short period, a spread sample for a long one)"""
    blocks, step = RANGES[rng]
    first = max(1, tip - blocks + 1)
    stride = max(1, blocks // SAMPLE)
    reach = max(step, blocks // 52)
    heights = [tip - d * step for d in range(blocks // step) if tip - d * step > 1][::-1]
    stamp = {}
    for h in heights:
        if h in _headers:
            stamp[_headers[h][0]] = h
    points = []
    for pt in hr["hashrates"]:
        h = stamp.get(pt["timestamp"])
        if h is None:
            continue
        seen = [_payouts[k] for k in range(h - reach + 1, h + 1) if k % stride == 0 and k >= first and k in _payouts]
        if seen:
            share = sum(1 for o in seen if o > 1) / len(seen)
            points.append({"timestamp": pt["timestamp"], "avgHashrate": pt["avgHashrate"] * share, "share": share, "networkHashrate": pt["avgHashrate"]})
    if not points:
        raise RuntimeError("no data yet")
    seen = [_payouts[k] for k in range(max(first, tip - max(step, 5040) + 1), tip + 1) if k % stride == 0 and k in _payouts]
    now = sum(1 for o in seen if o > 1) / len(seen) if seen else points[-1]["share"]
    return {"currentHashrate": hr["currentHashrate"] * now, "currentShare": now, "networkHashrate": hr["currentHashrate"], "complete": True,
            "sampled": stride > 1, "pool": "P2Pool", "hashrates": points}


def worker():
    first = True
    while True:
        try:
            info = rpc("get_info")
            tip = int(info["height"]) - 1
            for rng in RANGES:                # the short periods first, so they are ready soonest
                hr, pl = hashrate_range(tip, info, rng), pools_range(tip, rng)
                try:
                    ph = pool_hashrate_range(tip, rng, hr)
                except Exception as exc:
                    log("pool hashrate " + rng + ": " + str(exc))
                    ph = None
                with _lock:
                    _result["hashrate"][rng], _result["pools"][rng] = hr, pl
                    if ph:
                        _result["pool-hashrate"][rng] = ph
                    _result["info"] = info
                if first and rng == "24h":
                    log("Monero mining statistics ready (longer periods follow)")
            first = False
        except Exception as exc:
            log("refresh: " + str(exc))
        time.sleep(600)


# ---------- the web server ----------

HOP = {"connection", "keep-alive", "transfer-encoding", "te", "trailer", "upgrade", "proxy-authenticate",
       "proxy-authorization", "content-length", "server", "date"}


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "hashes.space"

    def log_message(self, fmt, *args):     # one line per request, without the client address
        log(fmt % args)

    def send_json(self, code, obj, seconds):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(seconds))
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def mining(self, path):
        m = re.fullmatch(r"/api/v1/mining/(hashrate|pools|pool-hashrate)/(\w+)", path)
        if not m:
            return self.send_json(404, {"error": "unknown endpoint"}, 0)
        kind, rng = m.groups()
        with _lock:
            data = _result[kind].get(rng)
        if data is None:
            return self.send_json(503 if rng in RANGES else 404, {"error": "Mining statistics are being computed from your node, try again in a minute" if rng in RANGES else "unknown period"}, 0)
        return self.send_json(200, data, 300)

    def forward(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP and k.lower() != "host"}
        try:
            conn = http.client.HTTPConnection(EXPLORER_HOST, EXPLORER_PORT, timeout=60)
            conn.request(self.command, self.path, body=body, headers=headers)
            r = conn.getresponse()
            data = r.read()
        except Exception as exc:
            return self.send_json(502, {"error": "the explorer did not answer: " + str(exc)}, 0)
        finally:
            try:
                conn.close()
            except Exception:
                pass
        self.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def handle_any(self):
        path = self.path.split("?")[0]
        if path.startswith("/api/v1/mining/") and self.command in ("GET", "HEAD"):
            return self.mining(path)
        return self.forward()

    do_GET = do_POST = do_HEAD = do_OPTIONS = handle_any


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    if NODE:
        threading.Thread(target=worker, daemon=True).start()
    else:
        log("no Monero node configured: only passing the explorer through")
    log("listening on port " + str(PORT))
    Server(("0.0.0.0", PORT), Handler).serve_forever()
