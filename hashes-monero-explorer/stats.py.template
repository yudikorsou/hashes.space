TAIL_EMISSION_HEIGHT = 2641623      # from here every block's base reward is the tail emission of 0.6 XMR: the rest of the reward is fees
TAIL_REWARD = 600_000_000_000


def xmr(atomic):
    return "{:.12f}".format(atomic / 1e12).rstrip("0").rstrip(".") or "0"


def esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&#39;")


def ago(ts):
    d = max(0, int(time.time()) - int(ts))
    return "{}s ago".format(d) if d < 60 else "{}m ago".format(d // 60) if d < 3600 else "{}h ago".format(d // 3600) if d < 86400 else "{}d ago".format(d // 86400)


def page(title, body):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>" + esc(title) + " · Monero explorer</title>"
            "<style>" + PAGE_CSS + "</style></head><body><header><a class=brand href='/'>Monero <span>explorer</span></a>"
            "<form action='/search' method=get><input name=value placeholder='Block height, block hash or transaction hash' aria-label=Search><button>Search</button></form></header>"
            "<main>" + body + "</main><footer>Read from your own Monero node · hashes.space</footer></body></html>")


def block_page(ident):
    res = rpc("get_block", {"height": int(ident)} if ident.isdigit() else {"hash": ident.lower()})
    hd = res["block_header"]
    height = int(hd["height"])
    miner = json.loads(res["json"])["miner_tx"]
    payouts = max(1, len(miner.get("vout") or []))
    reward = int(hd["reward"])
    fees = reward - TAIL_REWARD if height >= TAIL_EMISSION_HEIGHT and reward >= TAIL_REWARD else None
    try:
        gap = int(hd["timestamp"]) - header_at(height - 1)[0] if height > 0 else None
    except Exception:
        gap = None
    depth = int(hd.get("depth", 0))
    stamp = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(int(hd["timestamp"])))

    def btn(href, label):
        return "<a href='" + href + "'>" + label + "</a>" if href else "<span class=off>" + label + "</span>"
    who = ("P2Pool · " + str(payouts) + " miners paid") if payouts > 1 else "a single payout (pool or solo)"
    head = ("<div class=bhero><h1>Block " + "{:,}".format(height) + "</h1><span class=chip>Paid to <b>" + who + "</b></span><span class=chip>" + stamp + " (" + ago(hd["timestamp"]) + ")</span>"
            "<span class=chip><b>" + "{:,}".format(depth) + "</b> confirmation" + ("" if depth == 1 else "s") + "</span>"
            "<div class=navbtns>" + btn("/block/" + hd["prev_hash"] if height > 0 else "", "← previous") + btn("/block/" + str(height + 1) if depth > 0 else "", "next →") + "</div></div>"
            "<div class=bhash><small>Block hash</small><span class=mono>" + esc(hd["hash"]) + "</span></div>")
    tiles = [("Transactions", "{:,}".format(int(hd["num_txes"])), ""), ("Reward", xmr(reward), "XMR" + (" · 0.6 base + fees" if fees is not None else "")),
             ("Fees", xmr(fees) if fees is not None else "-", "XMR"), ("Size", "{:,} B".format(int(hd["block_size"])), "{:,} B weight".format(int(hd.get("block_weight", hd["block_size"])))),
             ("Difficulty", "{:,}".format(int(hd["difficulty"])), "")]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:18px'>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + "</div>" for k, v, sub in tiles)
    mining = [("Miner reward tx", "<a class=mono href='/tx/" + esc(hd["miner_tx_hash"]) + "'>" + esc(hd["miner_tx_hash"]) + "</a>"), ("Payouts", str(payouts) + (" (P2Pool pays its miners in the block)" if payouts > 1 else " (a pool or a solo miner)")),
              ("Total reward", xmr(reward) + " XMR")] + ([("Block reward", "0.6 XMR"), ("Total fees", xmr(fees) + " XMR")] if fees is not None else [])
    header = [("Timestamp", stamp + " <span class=muted>(" + str(hd["timestamp"]) + ")</span>")] + ([("Since previous block", "{}:{:02d}:{:02d}".format(abs(gap) // 3600, abs(gap) % 3600 // 60, abs(gap) % 60))] if gap is not None else []) + [
              ("Version", "{}.{}".format(hd["major_version"], hd["minor_version"])), ("Nonce", "{:,}".format(int(hd["nonce"]))),
              ("Previous block", "<a class=mono href='/block/" + esc(hd["prev_hash"]) + "'>" + esc(hd["prev_hash"]) + "</a>")] + ([("PoW hash", "<span class=mono>" + esc(hd["pow_hash"]) + "</span>")] if hd.get("pow_hash") else [])
    gr = "".join("<section class=card><h2>" + t + "</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in rows) + "</dl></section>" for t, rows in (("Mining", mining), ("Header", header)))
    return page("Block " + str(height), head + "<div class=tiles>" + tl + "</div><div class=groups>" + gr + "</div>")


def tx_page(txid):
    """a transaction in the same design: where it was mined, its figures as tiles, then details, inputs and outputs in cards"""
    out = NODE_RPC.post("/get_transactions", json.dumps({"txs_hashes": [txid.lower()], "decode_as_json": True}).encode(), 20)
    if not out.get("txs"):
        raise RuntimeError("transaction not found")
    t = out["txs"][0]
    tx = json.loads(t["as_json"])
    vin, vout = tx.get("vin") or [], tx.get("vout") or []
    coinbase = bool(vin) and "gen" in vin[0]
    rct = tx.get("rct_signatures") or {}
    fee = int(rct.get("txnFee") or 0)
    size = len(t.get("as_hex", "")) // 2
    extra = bytes(tx.get("extra") or [])
    pubkey = extra[1:33].hex() if len(extra) >= 33 and extra[0] == 1 else ""
    in_pool = bool(t.get("in_pool"))
    height = t.get("block_height")
    ts = t.get("block_timestamp")
    conf = int(t.get("confirmations") or 0)
    total = sum(int(o.get("amount") or 0) for o in vout)
    indices = t.get("output_indices") or [[]]
    indices = indices[0] if indices and isinstance(indices[0], list) else indices

    def key_of(o):
        tg = o.get("target") or {}
        k = tg.get("tagged_key") or tg.get("key") or ""
        return k.get("key", "") if isinstance(k, dict) else k

    kind = "Miner reward (coinbase)" if coinbase else "Transaction"
    chips = ("<span class=chip><b>" + kind + "</b></span>"
             + (("<span class=chip>In block <a href='/block/" + str(height) + "'><b>" + "{:,}".format(int(height)) + "</b></a></span>") if height is not None and not in_pool else "<span class=chip><b>Waiting in the mempool</b></span>")
             + (("<span class=chip>" + time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(int(ts))) + " (" + ago(ts) + ")</span>") if ts and not in_pool else "")
             + ("<span class=chip><b>" + "{:,}".format(conf) + "</b> confirmation" + ("" if conf == 1 else "s") + "</span>" if not in_pool else ""))
    head = ("<div class=bhero><h1>Transaction</h1>" + chips + "</div><div class=bhash><small>Transaction hash</small><span class=mono>" + esc(txid.lower()) + "</span></div>")
    tiles = [("Outputs", "{:,}".format(len(vout)), ""), ("Inputs", "{:,}".format(0 if coinbase else len(vin)), "newly created coins" if coinbase else "")]
    if coinbase:
        tiles.append(("Total out", xmr(total), "XMR"))
    else:
        tiles.append(("Fee", xmr(fee), "XMR"))
    tiles += [("Size", "{:,} B".format(size), ""), ("Version", str(tx.get("version", "")), "RingCT type " + str(rct.get("type", 0)))]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:18px'>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + "</div>" for k, v, sub in tiles)
    details = ([("Block", "<a href='/block/" + str(height) + "'>" + "{:,}".format(int(height)) + "</a>")] if height is not None and not in_pool else []) + [
        ("Version", str(tx.get("version", ""))), ("RingCT type", str(rct.get("type", 0))), ("Unlock time", "{:,}".format(int(tx.get("unlock_time") or 0)))] + (
        [("Fee", xmr(fee) + " XMR")] if not coinbase else []) + ([("Tx public key", "<span class=mono>" + pubkey + "</span>")] if pubkey else []) + [
        ("Extra", "<span class=mono>" + extra.hex() + "</span>")]
    if coinbase:
        ins = "<p class=muted>Newly created coins: the block reward" + (" of block " + "{:,}".format(int(vin[0]["gen"]["height"])) if isinstance(vin[0].get("gen"), dict) and "height" in vin[0]["gen"] else "") + ".</p>"
    else:
        ins = ("<table><tr><th>#</th><th>Key image</th><th class=r>Ring size</th></tr>" + "".join(
            "<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + esc((i.get("key") or {}).get("k_image", "")) + "</td><td class=r>" + str(len((i.get("key") or {}).get("key_offsets") or [])) + "</td></tr>" for n, i in enumerate(vin)) + "</table>")
    outs = ("<table><tr><th>#</th><th>Stealth address</th><th class=r>Amount</th><th class=r>Output index</th></tr>" + "".join(
        "<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + esc(key_of(o)) + "</td><td class=r>" + (xmr(int(o["amount"])) + " XMR" if int(o.get("amount") or 0) else "<span class=muted>hidden</span>") + "</td><td class=r>"
        + (("{:,}".format(indices[n])) if n < len(indices) else "") + "</td></tr>" for n, o in enumerate(vout)) + "</table>")
    more = ("<section class=card><h2>Decode outputs or prove sending</h2><p class=muted>Check which outputs belong to a Monero address and view key, or prove a payment. The calculation runs on this server, so the address and view key are sent to it.</p>"
            "<p><a href='/tx/" + esc(txid.lower()) + "?classic=1'>Open the classic explorer page for this transaction</a></p></section>")
    body = (head + "<div class=tiles>" + tl + "</div><div class=groups><section class=card><h2>Details</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in details) + "</dl></section></div>"
            "<section class=card><h2>" + ("Input" if coinbase else "Inputs (" + str(len(vin)) + ")") + "</h2>" + ins + "</section><section class=card><h2>Outputs (" + str(len(vout)) + ")</h2>" + outs + "</section>" + more)
    return page("Transaction " + txid[:12], body)


def ranking_page():
    """the Fee-Per-Byte Ranking of the block that is being mined: the node's pool of waiting transactions, from the highest fee rate down"""
    info = rpc("get_info")
    height = int(info["height"])
    pool = NODE_RPC.post("/get_transaction_pool", b"{}", 20).get("transactions") or []
    median = max(300000, int(info.get("block_weight_median") or info.get("block_size_median") or 0))
    rows = []
    for t in pool:
        if t.get("double_spend_seen") or t.get("do_not_relay"):
            continue
        w = max(1, int(t.get("weight") or t.get("blob_size") or 1))
        rows.append((int(t["fee"]) / w / 1000.0, int(t["fee"]), w, t["id_hash"]))   # nXMR per byte: 1 nXMR is 1000 piconero
    rows.sort(reverse=True)
    total = len(rows)
    used, fit = 0, 0
    for r in rows:
        if used + r[2] > median:
            break
        used += r[2]
        fit += 1
    rates = [r[0] for r in rows]
    top = rates[0] if rates else 0
    med = rates[len(rates) // 2] if rates else 0
    head = ("<div class=bhero><h1>Fee-per-byte ranking</h1><span class=chip>Block being mined <b>" + "{:,}".format(height) + "</b></span><span class=chip><b>" + "{:,}".format(total) + "</b> waiting</span></div>")
    how = ("<section class=card><h2>What is this?</h2>"
           "<p class=lead>Miners fill a block with the transactions that pay the most <b>per byte</b>, not the most in total. The ranking below is that order, for the block being mined now.</p>"
           "<div class=steps><div class=step><span class=n>1</span><b>Fee</b> the sender pays the miner</div><div class=step><span class=n>2</span><b>÷ Bytes</b> the space it takes in the block</div>"
           "<div class=step><span class=n>3</span><b>= Rate</b> highest rate goes first</div></div>"
           "<p class=eg1>Example: A pays 0.00004 XMR for 2,000 B = 20 nXMR/B. B pays 0.00003 XMR for 1,000 B = <b>30 nXMR/B</b>, so B goes first although it pays less.</p></section>")
    tiles = [("Highest rate", "{:,.0f}".format(top), "nXMR/B"), ("Median rate", "{:,.0f}".format(med), "nXMR/B"), ("In the next block", "{:,}".format(fit), "of {:,} waiting".format(total)), ("Waiting after", "{:,}".format(total - fit), "for a later block")]
    tl = "".join("<div class=tile><small>" + k + "</small><b style='font-size:20px'>" + v + "</b><em>" + sub + "</em></div>" for k, v, sub in tiles)

    def row(n, r):
        rate, fee, w, txid = r
        pct = max(3, int(rate / top * 100)) if top else 0
        return ("<tr class='" + ("in" if n < fit else "out") + "'><td class=n>" + str(n + 1) + "</td><td class=bar><div><span style='width:" + str(pct) + "%'></span><b>" + "{:,.0f}".format(rate) + "</b></div></td>"
                "<td class=r>" + xmr(fee) + "</td><td class=r>" + "{:,}".format(w) + "</td><td><a class=mono href='/tx/" + esc(txid) + "'>" + esc(txid[:6]) + "…" + esc(txid[-4:]) + "</a></td></tr>")
    th = "<tr><th>#</th><th>Fee rate (nXMR/B)</th><th class=r>Fee (XMR)</th><th class=r>Bytes</th><th>Tx</th></tr>"
    cut = "<tr class=cut><td colspan=5><span>Block full · " + "{:,}".format(used) + " of " + "{:,}".format(median) + " bytes · everything below waits</span></td></tr>"

    def lines(idx):
        out = []
        for n in idx:
            if n == fit and fit:
                out.append(cut)
            out.append(row(n, rows[n]))
        return "".join(out)
    first = list(range(min(8, total)))
    if fit > 8:
        gap = "<tr class=gap><td colspan=5><span>" + "{:,}".format(fit - 8) + " more in the block, down to " + "{:,.0f}".format(rates[fit - 1]) + " nXMR/B</span></td></tr>"
        tail = list(range(fit - 1, min(fit + 3, total)))
        short = lines(first) + gap + lines(tail)
    else:
        short = lines(list(range(min(fit + 3, total))))
    full = lines(list(range(min(total, 200))))
    legend = "<p class=legend><span class=k1></span> in the next block <span class=k2></span> waiting</p>"
    data = json.dumps([[x[3], round(x[0], 1), x[1], x[2]] for x in rows[:5000]], separators=(",", ":"))
    finder = ("<form class=finder onsubmit='return false'><input id=q placeholder='Find your transaction: paste its hash' aria-label='Find a transaction in the ranking' autocomplete=off spellcheck=false><button type=button id=go>Find</button></form>"
              "<div id=hit class=hit hidden></div>"
              "<script>(function(){var R=" + data + ",FIT=" + str(fit) + ",USED=" + str(used) + ",MED=" + str(median) + ",N=" + str(total) + ",LOW=" + json.dumps(round(rates[fit - 1], 1) if fit else None) + ";"
              "var q=document.getElementById('q'),hit=document.getElementById('hit');"
              "function nx(v){return Number(v).toLocaleString(undefined,{maximumFractionDigits:1})}"
              "function run(){var v=q.value.trim().toLowerCase().replace(/^0x/,'');if(v.length<6){hit.hidden=true;return}"
              "var m=R.map(function(r,i){return r[0].indexOf(v)===0||r[0].indexOf(v)>0&&v.length>=10?i:-1}).filter(function(i){return i>=0});"
              "hit.hidden=false;if(!m.length){hit.className='hit miss';hit.innerHTML='<b>Not in the ranking.</b> The transaction may already be mined, or this node has not seen it yet.'+(/^[0-9a-f]{64}$/.test(v)?' <a href=\"/tx/'+v+'\">Look it up</a>':'');return}"
              "var i=m[0],r=R[i],inb=i<FIT,w=r[3];hit.className='hit '+(inb?'in':'out');"
              "hit.innerHTML='<div class=hn>#'+(i+1)+'</div><div><b>'+(inb?'In the next block':'Waiting for a later block')+'</b><br>Rate <b>'+nx(r[1])+'</b> nXMR/B for '+nx(w)+' bytes. '+(inb?(i)+' transactions pay more per byte.':'The block is full after #'+FIT+'; a rate of about '+nx(LOW)+' nXMR/B or more gets in.')+' <a href=\"/tx/'+r[0]+'\">Open transaction</a>'+(m.length>1?' ('+m.length+' matches, first shown)':'')+'</div>';}"
              "q.addEventListener('input',run);document.getElementById('go').addEventListener('click',run);q.addEventListener('keydown',function(e){if(e.key==='Enter')run()})})();</script>")
    table = ("<section class=card><h2>The ranking</h2>" + finder + legend + ("<table class=rank>" + th + short + "</table>" + ("<details><summary>Show all " + "{:,}".format(total) + (" (first 200)" if total > 200 else "") + "</summary><table class=rank>" + th + full + "</table></details>" if total > len(short) // 120 + 12 else "")
             if rows else "<p class=muted>No transactions are waiting right now: the next block is empty apart from its miner reward.</p>") + "</section>")
    return page("Fee-per-byte ranking", head + how + "<div class=tiles>" + tl + "</div>" + table)


# ---------- the block template of your node: header fields and the merkle root (Monero's tree hash) ----------
# Monero hashes with the original Keccak-256 (not the SHA-3 that hashlib offers), so it is written out here.
_RC = [0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000, 0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
       0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A, 0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
       0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008]
_ROT = [[0, 36, 3, 41, 18], [1, 44, 10, 45, 2], [62, 6, 43, 15, 61], [28, 55, 25, 21, 56], [27, 20, 39, 8, 14]]
_M64 = (1 << 64) - 1


def _keccak_f(a):
    for rc in _RC:
        c = [a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4] for x in range(5)]
        d = [c[(x - 1) % 5] ^ (((c[(x + 1) % 5] << 1) | (c[(x + 1) % 5] >> 63)) & _M64) for x in range(5)]
        a = [[a[x][y] ^ d[x] for y in range(5)] for x in range(5)]
        b = [[0] * 5 for _ in range(5)]
        for x in range(5):
            for y in range(5):
                v, n = a[x][y], _ROT[x][y]
                b[y][(2 * x + 3 * y) % 5] = ((v << n) | (v >> (64 - n))) & _M64 if n else v
        a = [[b[x][y] ^ ((~b[(x + 1) % 5][y]) & b[(x + 2) % 5][y]) for y in range(5)] for x in range(5)]
        a[0][0] ^= rc
    return a


def keccak256(data):
    rate = 136
    data = bytearray(data) + b"\x01"
    data += b"\x00" * (-len(data) % rate)
    data[-1] |= 0x80
    a = [[0] * 5 for _ in range(5)]
    for off in range(0, len(data), rate):
        for i in range(rate // 8):
            a[i % 5][i // 5] ^= int.from_bytes(data[off + 8 * i:off + 8 * i + 8], "little")
        a = _keccak_f(a)
    return b"".join(a[i % 5][i // 5].to_bytes(8, "little") for i in range(4))


def tree_hash(hashes):
    """the merkle root of a block's transaction hashes, as Monero builds it (the miner transaction first)"""
    count = len(hashes)
    if count == 1:
        return hashes[0]
    if count == 2:
        return keccak256(hashes[0] + hashes[1])
    cnt = 2
    while cnt < count:
        cnt <<= 1
    cnt >>= 1
    ints = list(hashes[:2 * cnt - count]) + [b""] * (count - cnt)
    i = 2 * cnt - count
    for j in range(2 * cnt - count, cnt):
        ints[j] = keccak256(hashes[i] + hashes[i + 1])
        i += 2
    ints = ints[:cnt]
    while cnt > 2:
        cnt >>= 1
        ints = [keccak256(ints[2 * k] + ints[2 * k + 1]) for k in range(cnt)]
    return keccak256(ints[0] + ints[1])


_template = {"at": 0, "data": None}


def block_template():
    """what your node would put in the next block: the header fields and the tree hash of the miner transaction and the best-paying pool transactions.
    The miner transaction pays whoever finds the block, which only the miner knows: a stand-in transaction hash takes its place, as the Block assembly shows it."""
    if _template["data"] and time.time() - _template["at"] < 8:
        return _template["data"]
    info = rpc("get_info")
    hdr = rpc("get_last_block_header")["block_header"]
    pool = NODE_RPC.post("/get_transaction_pool", b"{}", 20).get("transactions") or []
    best = sorted((t for t in pool if not t.get("double_spend_seen") and not t.get("do_not_relay")), key=lambda t: t["fee"] / max(1, t["weight"]), reverse=True)
    ids = [t["id_hash"] for t in best[:60]]
    height = int(info["height"])
    coinbase = keccak256(("miner_tx|%d|hashes.space" % height).encode())
    root = tree_hash([coinbase] + [bytes.fromhex(i) for i in ids])
    data = {"height": height, "majorVersion": int(hdr["major_version"]), "minorVersion": int(hdr["minor_version"]), "timestamp": int(time.time()),
            "prevId": info["top_block_hash"], "nonce": None, "merkleroot": root.hex(), "nTx": len(ids) + 1, "txids": ids[:3],
            "reward": int(hdr.get("reward") or 0), "difficulty": int(info.get("difficulty") or 0)}
    _template["data"], _template["at"] = data, time.time()
    return data


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "hashes.space"

    def log_message(self, fmt, *args):     # one line per request, without the client address
        log(fmt % args)

    def send_json(self, code, obj, seconds):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(seconds))
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def mining(self, path):
        m = re.fullmatch(r"/api/v1/mining/(hashrate|pools|pool-hashrate)/(\w+)", path)
        if not m:
            return self.send_json(404, {"error": "unknown endpoint"}, 0)
        kind, rng = m.groups()
        with _lock:
            data = _result[kind].get(rng)
        if data is None:
            return self.send_json(503 if rng in RANGES else 404, {"error": "Mining statistics are being computed from your node, try again in a minute" if rng in RANGES else "unknown period"}, 0)
        return self.send_json(200, data, 300)

    def forward(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP and k.lower() != "host"}
        try:
            conn = http.client.HTTPConnection(EXPLORER_HOST, EXPLORER_PORT, timeout=60)
            conn.request(self.command, self.path, body=body, headers=headers)
            r = conn.getresponse()
            data = r.read()
        except Exception as exc:
            return self.send_json(502, {"error": "the explorer did not answer: " + str(exc)}, 0)
        finally:
            try:
                conn.close()
            except Exception:
                pass
        self.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def handle_any(self):
        path = self.path.split("?")[0]
        if path.startswith("/api/v1/mining/") and self.command in ("GET", "HEAD"):
            return self.mining(path)
        if path == "/api/v1/block-template" and self.command in ("GET", "HEAD") and NODE:
            try:
                return self.send_json(200, block_template(), 8)
            except Exception as exc:
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
        if path == "/fee-ranking" and self.command == "GET" and NODE:
            try:
                body = ranking_page().encode()
            except Exception as exc:
                log("fee ranking:", exc)
                return self.send_json(502, {"error": "the node did not answer: " + str(exc)}, 0)
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            return self.wfile.write(body)
        m = re.fullmatch(r"/block/([0-9]{1,9}|[0-9a-fA-F]{64})", path)
        t = re.fullmatch(r"/tx/([0-9a-fA-F]{64})", path)
        if (m or t) and self.command == "GET" and NODE and "classic=1" not in self.path:
            try:
                body = (block_page(m.group(1)) if m else tx_page(t.group(1))).encode()
            except Exception as exc:        # the node did not answer or does not know the block: the explorer's own page is the fallback
                log("block page:", exc)
            else:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                return self.wfile.write(body)
        return self.forward()

    do_GET = do_POST = do_HEAD = do_OPTIONS = handle_any


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    if NODE:
        threading.Thread(target=worker, daemon=True).start()
    else:
        log("no Monero node configured: only passing the explorer through")
    log("listening on port " + str(PORT))
    Server(("0.0.0.0", PORT), Handler).serve_forever()
