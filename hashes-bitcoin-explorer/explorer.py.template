def cube_html(b, st, pool):
    """the block as the Find Mempool page draws it: the 3D block with its height, coin, fee rate and transaction count; the middle of its front face is where the transactions resolve"""
    coin = "<svg class=cube-coin viewBox='0 0 32 32'><circle cx=16 cy=16 r=16 fill='" + CFG["accent"] + "'/><text x=16 y=22.5 text-anchor=middle font-size=19 font-weight=700 fill='#fff'>₿</text></svg>"
    return ("<div class=block-wrap><div class='above height'><b>" + "{:,}".format(b["height"]) + "</b></div><div class=cube id=anim-cube><div class='face front' id=anim-front style='background:#2d3348'>" + coin + "<div class=txt>"
            "<div class=mid id=anim-mid></div><span class=txs id=anim-ctx>0 transactions</span><span class=time>" + ago(b["time"]) + "</span></div><div class=flylayer id=anim-layer></div></div>"
            "<div class='face top'></div><div class='face side'></div></div><div class=below>" + html.escape(pool) + "</div></div>")


def block_animation(b, h):
    """each transaction of the block as an animation: the coins it spends (sending) and the outputs it creates (receiving), flying into the block"""
    txs = b["tx"]
    data = []
    rates = sorted(float(t["fee"]) * 1e8 / t["vsize"] for t in txs[1:] if "fee" in t and t.get("vsize"))
    st = {"med": round(rates[len(rates) // 2], 1) if rates else 0, "lo": round(rates[0]) if rates else 0, "hi": round(rates[-1]) if rates else 0}
    cb0 = txs[0]
    addrs0 = [o.get("scriptPubKey", {}).get("address") for o in cb0.get("vout", []) if o.get("scriptPubKey", {}).get("address")]
    pool = POOLS.find(bytes.fromhex(cb0["vin"][0].get("coinbase", "")).decode("latin-1"), addrs0)
    for t in txs[:ANIM_MAX]:
        cb = "coinbase" in t["vin"][0]
        ins = []
        for i in t["vin"][:3]:
            if "coinbase" in i:
                ins.append(["Coinbase", "newly created coins"])
                continue
            po = i.get("prevout") or {}
            who = out_label(po, True) if po.get("scriptPubKey", {}).get("address") else ""
            ins.append({"h": i["txid"], "n": i["vout"]})
        ins = ins[:2]
        outs = [[out_label(o, True), btc(round(float(o["value"]) * 1e8))] for o in t["vout"][:3]]
        if len(t["vout"]) > 3:
            outs[2] = ["+" + str(len(t["vout"]) - 2) + " more outputs", ""]
        rate = round(float(t["fee"]) * 1e8 / t["vsize"], 1) if "fee" in t and t.get("vsize") else 0
        data.append({"id": t["txid"], "idf": t["txid"], "cb": cb, "nin": len(t["vin"]), "nout": len(t["vout"]), "vs": t.get("vsize", 0), "r": rate, "ins": ins, "outs": outs})
    blob = json.dumps({"height": "{:,}".format(b["height"]), "hash": h, "total": len(txs), "size": b["size"], "full": min(100.0, b["weight"] / 40000.0),
                           "totalVs": sum(t.get("vsize", 0) for t in txs), "txs": data}, separators=(",", ":")).replace("</", "<\\/")
    return ("<section class=card><h2>Every transaction hash going into block " + "{:,}".format(b["height"]) + "</h2><div class=animbar>"
            "<input id=anim-seek type=range min=0 value=0 aria-label='Transaction'><span id=anim-label class=muted></span><a id=anim-link class=mono href='#'></a></div>"
            "<div class=animwrap id=anim-wrap>" + FAN_HTML + cube_html(b, st, pool)
            + "</div>"
            "<p class=muted>Each transaction in turn: the coins it spends (sending) travel into the block, then the outputs it creates (receiving) resolve in the middle of it, and the block fills.</p>"
            "<script>" + ANIM_JS.replace("__DATA__", blob) + "</script></section>")


def block_diagrams(b):
    """the diagrams of a block page, worked out from the transactions of the block"""
    txs = b["tx"][1:]
    sub = SUBSIDY0 >> (b["height"] // 210000)
    fees = sum(round(float(t.get("fee", 0)) * 1e8) for t in txs)
    rated = [(float(t["fee"]) * 1e8 / t["vsize"], t["vsize"]) for t in txs if "fee" in t and t.get("vsize")]
    out = ""
    full = min(100.0, b["weight"] / 40000.0)
    bands = []
    for lo, hi, lab, col in FEE_BANDS:
        v = sum(vs for rt, vs in rated if lo <= rt < hi)
        bands.append((lab + " sat/vB", v, col))
    tv = sum(v for _, v, _ in bands) or 1
    seg = "".join("<i style='width:" + "{:.3f}".format(100.0 * v / tv * full / 100) + "%;background:" + col + "' title='" + lab + ": " + "{:.1f}".format(100.0 * v / tv) + "% of the block'></i>" for lab, v, col in bands)
    out += ("<div class='chart wide'><h2>What fills the block: " + "{:.1f}".format(full) + "% of the weight limit, by fee rate</h2><div class=fill>" + seg + "</div><ul class=legend>"
            + "".join("<li><i style='background:" + col + "'></i>" + lab + " <b>" + "{:.1f}".format(100.0 * v / tv) + "%</b></li>" for lab, v, col in bands) + "</ul></div>")
    edges = [(0, 2), (2, 3), (3, 5), (5, 8), (8, 12), (12, 20), (20, 35), (35, 60), (60, 120), (120, 1e12)]
    labs = ["<2", "2", "3–5", "5–8", "8–12", "12–20", "20–35", "35–60", "60–120", "120+"]
    out += svg_hist([(labs[i], sum(1 for rt, _ in rated if lo <= rt < hi)) for i, (lo, hi) in enumerate(edges)], "Transactions by fee rate", "sat/vB", "#f7931a")
    sizes = [(0, 150, "<150"), (150, 250, "150–250"), (250, 400, "250–400"), (400, 700, "400–700"), (700, 1500, "700–1.5k"), (1500, 1e12, "1.5k+")]
    out += svg_hist([(lab, sum(1 for t in txs if lo <= t.get("vsize", 0) < hi)) for lo, hi, lab in sizes], "Transactions by size", "vBytes", "#3ce26b")
    cnt = {}
    for t in txs:
        for o in t["vout"]:
            k = o.get("scriptPubKey", {}).get("type", "nonstandard")
            cnt[k] = cnt.get(k, 0) + 1
    cols = ["#f7931a", "#1bd8f4", "#3ce26b", "#f2b53c", "#9ea4bc", "#ff4d4d", "#4a5263", "#454d68"]
    items = [(TYPE_NAMES.get(k, k), v, cols[i % len(cols)]) for i, (k, v) in enumerate(sorted(cnt.items(), key=lambda x: -x[1])[:8])]
    out += "<div class=chart><h2>Output types</h2>" + hbars(items, sum(cnt.values())) + "</div>"
    out += svg_donut([("Subsidy", sub, "#4a5263"), ("Fees", fees, "#f7931a")], "Miner reward", "{:.3f}".format((sub + fees) / 1e8))
    try:
        pc = NODE.call("getblockstats", b["hash"], ["feerate_percentiles"], timeout=60).get("feerate_percentiles")
    except Exception:  # noqa: BLE001
        pc = None
    out += svg_rate_range(pc)
    return "<h2 class=sec>Block diagrams</h2><div class='charts diagrams'>" + out + "</div>"


def difficulty_text(b):
    """the block's difficulty. The BLAKE2b chain's node reports 0 (its 'difficulty' is measured against the SHA-256 limit), so there it is the hashes a block takes, worked out from the header's bits"""
    d = b.get("difficulty") or 0
    if CHAIN != "blake2b" and d:
        return "{:,.0f}".format(d)
    try:
        w = bits_work(b["bits"])
    except (KeyError, ValueError):
        return "{:,.0f}".format(d)
    return "{:,}".format(w) + " <span class=muted>hashes per block</span>"


def header_rows(b):
    """the block header as the node reports it (getblock / getblockheader): version and signalling, merkle root, bits, nonce, chainwork, median time"""
    ver = b.get("version")
    rows = []
    if ver is not None:
        rows.append(("Version", "0x{:08x}".format(ver) + (" · BIP9 signalling" if (ver >> 29) == 1 else "")))
    if b.get("merkleroot"):
        rows.append(("Merkle root", "<span class=mono>" + str(b["merkleroot"]) + "</span>"))
    if b.get("bits"):
        rows.append(("Bits", "<span class=mono>" + str(b["bits"]) + "</span>"))
    if "nonce" in b:
        rows.append(("Nonce", "{:,}".format(b["nonce"])))
    if b.get("mediantime"):
        rows.append(("Median time", time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(b["mediantime"]))))
    if b.get("chainwork"):
        rows.append(("Chainwork", "<span class=mono>" + str(b["chainwork"]).lstrip("0") + "</span> (2^{:.2f} hashes)".format(__import__("math").log2(max(1, int(b["chainwork"], 16))))))
    return rows


def block_layout(height, nav_prev, nav_next, pool, mined, hash_, tiles, groups, extra="", conf=None):
    """structured block page: title row (height, pool, time, previous/next), the hash, key figures as tiles, then the details grouped in cards"""
    def btn(href, label):
        return "<a href='/block/" + href + "'>" + label + "</a>" if href else "<span class=off>" + label + "</span>"
    head = ("<div class=bhero><h1>Block " + "{:,}".format(height) + "</h1>" + ("<span class=chip>Mined by <b>" + html.escape(pool) + "</b></span>" if pool else "")
            + "<span class=chip>" + mined + "</span>" + ("<span class=chip><b>" + "{:,}".format(conf) + "</b> confirmation" + ("" if conf == 1 else "s") + "</span>" if conf is not None else "") + "<div class=navbtns>" + btn(nav_prev, "← previous") + btn(nav_next, "next →") + "</div></div>"
            + "<div class=bhash><small>Block hash</small><span class=mono>" + hash_ + "</span></div>")
    tl = "".join("<div class=tile><small>" + k + "</small><b>" + v + "</b>" + (("<em>" + sub + "</em>") if sub else "") + (("<div class=meter><i style='width:" + "{:.1f}".format(min(100.0, bar)) + "%'></i></div>") if bar is not None else "") + "</div>"
                 for k, v, sub, bar in tiles)
    gr = "".join("<section class=card><h2>" + t + "</h2><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in rows) + "</dl></section>" for t, rows in groups if rows)
    return head + "<div class=tiles>" + tl + "</div><div class=groups>" + gr + "</div>" + extra


def block_stats_card(h):
    try:
        st = block_statistics(h)
    except Exception:  # noqa: BLE001
        return ""
    p = st.get("feeRatePercentiles") or []
    seg, tap = st["segwitShare"] * 100, st["taprootShare"] * 100
    items = [("Average fee", btc(st["avgFee"]), "{:.1f} sat/vB on average".format(st["avgFeeRate"]), None), ("Median fee", btc(st["medianFee"]), "per transaction", None),
             ("Fee rate range", ("{:g} – {:g}".format(st["minFeeRate"], st["maxFeeRate"])) if p else "-", "sat/vB, lowest to highest", None),
             ("Total sent", btc(st["totalOut"]), "moved by the transactions", None),
             ("SegWit", "{:.1f}%".format(seg), "of the transactions", seg), ("Taproot", "{:.1f}%".format(tap), "of the transactions", tap),
             ("Inputs / outputs", "{:,} / {:,}".format(st["inputs"], st["outputs"]), "{:,} OP_RETURN outputs".format(st["opReturnOutputs"]), None),
             ("Average transaction", "{:,} B".format(st["avgTxSize"]), "bytes per transaction", None),
             ("UTXO set", "{:+,}".format(st["utxoIncrease"]), "outputs added minus spent", None)]
    return ("<h2 class=sec>Block statistics</h2><div class='tiles wide'>" + "".join(
        "<div class=tile><small>" + k + "</small><b style='font-size:17px'>" + v + "</b><em>" + sub + "</em>"
        + (("<div class=meter><i style='width:" + "{:.1f}".format(min(100.0, bar)) + "%'></i></div>") if bar is not None else "") + "</div>" for k, v, sub, bar in items) + "</div>")


def block_page(ident):
    h = NODE.call("getblockhash", int(ident)) if ident.isdigit() else ident
    if not HEX64.fullmatch(h):
        raise ValueError("not a block")
    try:
        b = NODE.call("getblock", h, 2, timeout=120)
    except RuntimeError as exc:
        hd = NODE.call("getblockheader", h)       # the header is never pruned
        tiles = [("Transactions", "{:,}".format(hd.get("nTx", 0)), "", None), ("Difficulty", difficulty_text(hd), "", None)]
        note = ("<section class=card><p class=muted>This node is pruned: it has deleted the transactions of this block (" + html.escape(str(exc))
                + "), but a node never prunes a block's header, which is shown above.</p></section>")
        return page("Block " + str(hd["height"]), block_layout(hd["height"], hd.get("previousblockhash"), hd.get("nextblockhash"), "",
                    time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(hd["time"])) + " (" + ago(hd["time"]) + ")", h,
                    tiles, [("Header", header_rows(hd))], note, conf=hd.get("confirmations", 0)))
    txs = b["tx"]
    fees = sum(round(float(t.get("fee", 0)) * 1e8) for t in txs[1:])
    cb = txs[0]
    text = bytes.fromhex(cb["vin"][0].get("coinbase", "")).decode("latin-1")
    addrs = [o.get("scriptPubKey", {}).get("address") for o in cb.get("vout", []) if o.get("scriptPubKey", {}).get("address")]
    pool = POOLS.find(text, addrs)
    protect(pool)
    subsidy = SUBSIDY0 >> (b["height"] // 210000)
    full = b["weight"] / 40000
    tiles = [("Transactions", "{:,}".format(len(txs)), "", None), ("Fees", btc(fees), "", None),
             ("Reward", btc(fees + subsidy), "subsidy " + btc(subsidy) + " + fees", None),
             ("Fullness", "{:.1f}%".format(full), "of the weight limit", full),
             ("Size", "{:,} B".format(b["size"]), "{:,} weight units".format(b["weight"]) + (" · {:,} B stripped".format(b["strippedsize"]) if "strippedsize" in b else ""), None)]
    mining = [("Pool", html.escape(pool)), ("Coinbase text", "<span class=mono>" + html.escape("".join(c if 32 <= ord(c) < 127 else "·" for c in text)) + "</span>"),
              ("Paid to", ("<span class=mono>" + html.escape(", ".join(dict.fromkeys(addrs)) or "-") + "</span>") if is_verified() else verify_box())]
    hdr = [("Difficulty", difficulty_text(b))] + header_rows(b)
    return page("Block " + str(b["height"]), block_layout(b["height"], b.get("previousblockhash"), b.get("nextblockhash"), pool,
                time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(b["time"])) + " (" + ago(b["time"]) + ")", h, tiles,
                [("Mining", mining), ("Header", hdr)], conf=b.get("confirmations", 0))
                + ("" if REQ.protected else block_animation(b, h)) + block_diagrams(b) + block_stats_card(h))


def pool_of_hash(block_hash):
    """the pool that mined a block, from its coinbase"""
    cb = NODE.call("getrawtransaction", NODE.call("getblock", block_hash, 1)["tx"][0], True, block_hash)
    addrs = [o.get("scriptPubKey", {}).get("address") for o in cb.get("vout", []) if o.get("scriptPubKey", {}).get("address")]
    return POOLS.find(bytes.fromhex(cb["vin"][0].get("coinbase", "")).decode("latin-1"), addrs)


def tx_page(txid, block_hash):
    try:
        tx = NODE.call("getrawtransaction", txid, 2, *([block_hash] if block_hash else []))
    except RuntimeError:
        try:
            tx = NODE.call("getrawtransaction", txid, True, *([block_hash] if block_hash else []))
        except RuntimeError:
            return old_tx_page(txid)
    if CHAIN != "blake2b" and (tx.get("blockhash") or block_hash):      # Bitcoin: only transactions of blocks mined by the protected pool hide their addresses
        try:
            protect(pool_of_hash(tx.get("blockhash") or block_hash))
        except (RuntimeError, ValueError, KeyError, IndexError):
            pass
    ins = "".join("<tr><td class='mono wrap'>" + ("coinbase" if "coinbase" in i else "<a href='/tx/" + i["txid"] + "'>" + i["txid"][:16] + "…</a>:" + str(i["vout"])) + "</td></tr>" for i in tx["vin"])
    outs = "".join("<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + html.escape(out_label(o)) + "</td><td class=r>"
                   + btc(round(float(o["value"]) * 1e8)) + "</td></tr>" for n, o in enumerate(tx["vout"]))
    bh = tx.get("blockhash")
    rows = [("Txid", "<span class=mono>" + tx["txid"] + "</span>"),
            ("Status", ("In block <a href='/block/" + bh + "'>" + bh[:16] + "…</a> · " + "{:,}".format(tx.get("confirmations", 0)) + " confirmations") if bh else "In the mempool, waiting for a block"),
            ("Size", "{:,} bytes · {:,} vB".format(tx["size"], tx["vsize"])), ("Total out", btc(round(sum(float(o["value"]) for o in tx["vout"]) * 1e8)))]
    if "fee" in tx:
        rows.append(("Fee", btc(round(float(tx["fee"]) * 1e8)) + " (" + "{:.1f}".format(float(tx["fee"]) * 1e8 / tx["vsize"]) + " sat/vB)"))
    if not bh:
        rows += tx_extras(txid)
    return page("Transaction", "<h1>Transaction</h1><section class=card><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in rows)
                + "</dl></section><section class=card><h2>Inputs</h2><table>" + ins + "</table></section><section class=card><h2>Outputs</h2><table><tr><th>#</th><th>Address</th><th class=r>Value</th></tr>"
                + outs + "</table></section>")


class Handler(BaseHTTPRequestHandler):
    server_version = CHAIN + "-explorer"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", cache=0):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(cache) if cache else "no-store")
        for c in getattr(REQ, "cookies", []):
            self.send_header("Set-Cookie", c)
        self.end_headers()
        self.wfile.write(data)

    def json(self, obj, cache=0):
        self.send(200, json.dumps(obj), "application/json", cache)

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        params = dict(p.split("=", 1) for p in query.split("&") if "=" in p)
        REQ.cookies, REQ.path, REQ.host = [], self.path, self.headers.get("X-Forwarded-Host") or self.headers.get("Host", "")
        REQ.ok = read_cookie(self.headers.get("Cookie"), "dv") == "1"
        REQ.protected = CHAIN == "blake2b"      # block and transaction pages narrow this down to the pool that mined the block
        try:
            if path == "/auth/discord":
                nxt = urllib.request.unquote(params.get("next", "/"))
                url, html_ = auth_start(nxt if nxt.startswith("/") and not nxt.startswith("//") else "/")
                return self.redirect(url) if url else self.send(200, html_)
            if path == "/auth/discord/callback":
                url, html_ = auth_callback({k: urllib.request.unquote(v) for k, v in params.items()}, self.headers.get("Cookie"))
                return self.redirect(url) if url else self.send(200, html_)
            if path == "/auth/logout":
                REQ.cookies.append("dv=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax")
                return self.redirect("/")
            if path == "/api/v1/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
                return self.websocket()
            if path == "/api/v1/blocks":
                return self.json([view(b) for b in need_live()[0]], 5)
            if path == "/api/v1/fees/mempool-blocks":
                return self.json(need_live()[1], 5)
            if path == "/api/blocks/tip/height":
                return self.send(200, str(need_live()[0][0]["height"]), "text/plain", 5)
            m = re.fullmatch(r"/api/v1/mining/pool/([a-z0-9-]+)/blocks(?:/(epoch|14d))?", path)
            if m and m.group(2):
                return self.json(STATS.pool_blocks(m.group(1), epoch=True, budget=6), 5)
            if m:
                return self.json(STATS.pool_blocks(m.group(1)), 60)
            m = re.fullmatch(r"/api/v1/block/([0-9]+|[0-9a-fA-F]{64})/stats", path)
            if m:
                return self.json(block_statistics(m.group(1)), 60)
            if path == "/api/v1/blocks/history":
                return self.json(STATS.history_rows(), 60)
            if path == "/api/v1/chain-tips":
                return self.json(chain_tips(), 30)
            m = re.fullmatch(r"/api/v1/tx/([0-9a-fA-F]{64})/projection", path)
            if m:
                return self.json(tx_projection(m.group(1).lower()), 5)
            m = re.fullmatch(r"/api/v1/address/([A-Za-z0-9]{14,90})", path)
            if m and not is_verified():
                return self.send(403, json.dumps({"error": "address lookups are for members of the DATUM verified community: sign in at /auth/discord"}), "application/json")
            if m:
                st = address_scan(m.group(1))
                return self.json(st["result"] if st["state"] == "done" else {"state": st["state"], "error": st.get("error")}, 0)
            if path == "/forks":
                return self.send(200, forks_page())
            m = re.fullmatch(r"/address/([A-Za-z0-9]{14,90})", path)
            if m and not is_verified():
                return self.send(200, page("Address", "<h1>Address</h1><section class=card>" + verify_box() + "</section>"))
            if m:
                return self.send(200, address_page(m.group(1)))
            if path == "/api/v1/block-template":
                return self.json(block_template(), 8)
            if path == "/api/v1/difficulty-adjustment":
                return self.json(difficulty_adjustment(), 30)
            if path == "/api/v1/fees/recommended":
                return self.json(recommended_fees(), 10)
            if path == "/api/v1/halving":
                return self.json(halving(), 60)
            if path == "/api/v1/network":
                return self.json(network(), 10)
            if path == "/api/v1/status":
                with STATE_LOCK:
                    s = {"live": not STATE["error"], "error": STATE["error"], "tip": STATE["blocks"][0]["height"] if STATE["blocks"] else None, "updated": STATE["at"],
                         "mempool": STATE["mempool_count"], "pruned": STATE["info"].get("pruned"), "node": STATE["info"].get("subversion"), "chain": CHAIN, "syncing": STATE["info"].get("initialblockdownload"),
                         "statistics": STATS.ready, "statisticsError": STATS.error, "pools": len(POOLS.tags) > 0}
                return self.json(s)
            m = re.fullmatch(r"/api/v1/mining/solo/(24h|14d|1w|1m|epoch)", path)
            if m:
                return self.json(STATS.solo(m.group(1)), 300)
            m = re.fullmatch(r"/api/v1/mining/pool-hashrate/(24h|14d|1m|6m|1y|epoch)", path)
            if m:
                return self.json(STATS.pool_hashrate(m.group(1)), 300)
            m = re.fullmatch(r"/api/v1/mining/(hashrate|pools)/(24h|14d|1w|1m|3m|6m|1y|epoch)", path)
            if m:
                kind, period = m.groups()
                if kind == "hashrate":
                    return self.json(STATS.hashrate("14d" if period == "1w" else "1m" if period == "3m" else period), 300)
                return self.json(STATS.pools(period), 300)
            if path == "/":
                return self.send(200, home())
            if path.startswith("/block/"):
                return self.send(200, block_page(path[7:]))
            if path.startswith("/tx/") and HEX64.fullmatch(path[4:]):
                return self.send(200, tx_page(path[4:].lower(), params.get("b")))
            if path == "/search":
                q = urllib.request.unquote(params.get("q", "").replace("+", " ")).strip()
                if q.isdigit():
                    return self.redirect("/block/" + q)
                if HEX64.fullmatch(q):
                    try:
                        NODE.call("getblockheader", q)
                        return self.redirect("/block/" + q)
                    except RuntimeError:
                        return self.redirect("/tx/" + q.lower())
                if ADDR_RE.fullmatch(q):
                    return self.redirect("/address/" + q)
                return self.send(404, page("Not found", "<h1>Nothing found</h1><p>Search for a block height, a block hash, a transaction id or an address.</p>"))
            return self.send(404, page("Not found", "<h1>Not found</h1>"))
        except (RuntimeError, ValueError, OSError, KeyError, IndexError) as exc:
            if path.startswith("/api/"):
                return self.send(503, json.dumps({"error": str(exc)}), "application/json")
            return self.send(502, page("Error", "<h1>Something went wrong</h1><p class=err>" + html.escape(str(exc)) + "</p>"))

    def redirect(self, to):
        self.send_response(302)
        self.send_header("Location", to)
        for c in getattr(REQ, "cookies", []):
            self.send_header("Set-Cookie", c)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def websocket(self):
        try:
            blocks, mempool = need_live()         # not live (node syncing, not answering): no upgrade, so the page uses another source at once
        except RuntimeError as exc:
            return self.send(503, json.dumps({"error": str(exc)}), "application/json")
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        sock = self.connection
        sock.settimeout(120)
        try:
            while True:
                head = self.rfile.read(2)
                if len(head) < 2:
                    break
                op, ln = head[0] & 0x0F, head[1] & 0x7F
                if ln == 126:
                    ln = struct.unpack(">H", self.rfile.read(2))[0]
                elif ln == 127:
                    ln = struct.unpack(">Q", self.rfile.read(8))[0]
                mask = self.rfile.read(4) if head[1] & 0x80 else b"\0\0\0\0"
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(self.rfile.read(ln)))
                if op == 8:
                    break
                if op == 9:
                    with _send_lock:
                        sock.sendall(bytes([0x8A, len(data)]) + data)
                    continue
                if op != 1:
                    continue
                try:
                    msg = json.loads(data)
                except ValueError:
                    continue
                if msg.get("action") == "want":
                    with _clients_lock:
                        _clients.add(sock)
                    blocks, mempool = need_live()
                    ws_send(sock, json.dumps({"blocks": [view(b) for b in blocks], "mempool-blocks": mempool}))
                elif msg.get("action") == "ping":
                    ws_send(sock, json.dumps({"pong": True}))
        except (OSError, RuntimeError, ValueError):
            pass
        finally:
            with _clients_lock:
                _clients.discard(sock)
            self.close_connection = True


def main():
    threading.Thread(target=POOLS.load, daemon=True).start()
    threading.Thread(target=poller, daemon=True).start()
    threading.Thread(target=stats_worker, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.daemon_threads = True
    log("node " + os.environ["RPC_HOST"] + ":" + os.environ.get("RPC_PORT", "8332") + ", listening on port " + str(PORT))
    server.serve_forever()


if __name__ == "__main__":
    main()
