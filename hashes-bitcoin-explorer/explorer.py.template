def short_addr(a):
    return a if len(a) <= 22 else a[:11] + "…" + a[-6:]


FAN_SVG = ("<svg viewBox='0 0 100 100' aria-hidden=true><g class=frame><circle cx=50 cy=50 r=40 stroke-width=4.2></circle><circle cx=12 cy=12 r=4.6 stroke-width=3></circle><circle cx=88 cy=12 r=4.6 stroke-width=3></circle>"
           "<circle cx=12 cy=88 r=4.6 stroke-width=3></circle><circle cx=88 cy=88 r=4.6 stroke-width=3></circle></g><g class=rotor><g transform='translate(50 50)'>"
           + "".join("<path transform='rotate(" + str(a) + ")' d='M -4.5,-8.5 C -10,-17 -9,-27 -1.5,-35.5 Q 12,-34 17.5,-24.5 C 10,-22 6,-16 5,-9'></path>" for a in (0, 72, 144, 216, 288))
           + "<circle r=10.5 class=hub></circle><polygon class=hub-cut points='0,-5.6 5.3,-1.7 3.3,4.5 -3.3,4.5 -5.3,-1.7'></polygon></g></g></svg>")
