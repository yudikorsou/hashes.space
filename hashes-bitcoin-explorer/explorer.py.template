SVG_TEXT = "fill='currentColor' font-size='12.5'"


def hbars(items, total, unit=""):
    """horizontal bars (label, value, colour) as a share of total: plain HTML so they scale to any width"""
    out = ""
    for label, v, col in items:
        pct = 100.0 * v / total if total else 0
        out += ("<div class=hb><span class=hl>" + html.escape(label) + "</span><span class=ht><i style='width:" + "{:.2f}".format(max(pct, 0.4 if v else 0)) + "%;background:" + col + "'></i></span>"
                "<span class=hv>" + "{:,}".format(v) + unit + " · " + "{:.1f}".format(pct) + "%</span></div>")
    return out


def svg_hist(buckets, title, xlabel, color):
    """a column histogram (label, value) with the value on top of each column"""
    w, h, pad = 520, 170, 22
    top = max([v for _, v in buckets] + [1])
    n = len(buckets)
    slot = (w - 2 * pad) / n
    parts = ""
    for i, (lab, v) in enumerate(buckets):
        bh = (h - 52) * v / top
        x = pad + i * slot + slot * 0.12
        parts += ("<rect x='{:.1f}' y='{:.1f}' width='{:.1f}' height='{:.1f}' rx=2 fill='{}'/>".format(x, h - 30 - bh, slot * 0.76, bh, color)
                  + "<text x='{:.1f}' y='{:.1f}' text-anchor=middle ".format(x + slot * 0.38, h - 34 - bh) + SVG_TEXT + ">" + "{:,}".format(v) + "</text>"
                  + "<text x='{:.1f}' y='{}' text-anchor=middle ".format(x + slot * 0.38, h - 16) + SVG_TEXT + ">" + html.escape(lab) + "</text>")
    return ("<div class=chart><h2>" + html.escape(title) + "</h2><svg viewBox='0 0 " + str(w) + " " + str(h) + "' role=img aria-label='" + html.escape(title) + "'>" + parts
            + "<text x='" + str(w // 2) + "' y='" + str(h - 3) + "' text-anchor=middle " + SVG_TEXT + ">" + html.escape(xlabel) + "</text></svg></div>")


def svg_donut(parts, title, center):
    """a donut of (label, value, colour) parts with the legend underneath"""
    import math
    tot = sum(v for _, v, _ in parts) or 1
    r_, cx, cy, sw = 52, 70, 70, 20
    circ = 2 * math.pi * r_
    off, arcs, legend = 0.0, "", ""
    for lab, v, col in parts:
        ln = circ * v / tot
        arcs += "<circle cx={} cy={} r={} fill=none stroke='{}' stroke-width={} stroke-dasharray='{:.2f} {:.2f}' stroke-dashoffset='{:.2f}' transform='rotate(-90 {} {})'/>".format(cx, cy, r_, col, sw, ln, circ - ln, -off, cx, cy)
        off += ln
        legend += "<li><i style='background:" + col + "'></i>" + html.escape(lab) + " <b>" + "{:.1f}".format(100.0 * v / tot) + "%</b></li>"
    return ("<div class=chart><h2>" + html.escape(title) + "</h2><div class=donut><svg viewBox='0 0 140 140' role=img aria-label='" + html.escape(title) + "'>" + arcs
            + "<text x=70 y=74 text-anchor=middle fill=currentColor font-size=15 font-weight=600>" + html.escape(center) + "</text></svg><ul>" + legend + "</ul></div></div>")


def svg_rate_range(pc):
    """box plot of the block's fee rates (10th, 25th, median, 75th, 90th percentile) on a log scale"""
    import math
    if not pc or len(pc) < 5:
        return ""
    lo, hi = math.log10(max(0.5, min(pc) * 0.8)), math.log10(max(pc) * 1.25 + 1)
    w, x0, x1 = 520, 20, 500
    X = lambda v: x0 + (x1 - x0) * (math.log10(max(v, 0.01)) - lo) / (hi - lo)  # noqa: E731
    ticks = [t for t in (1, 2, 5, 10, 20, 50, 100, 200, 500, 1000) if 10 ** lo <= t <= 10 ** hi]
    g = "".join("<line x1={0:.1f} x2={0:.1f} y1=20 y2=78 stroke='#2d3348'/><text x={0:.1f} y=94 text-anchor=middle ".format(X(t)) + SVG_TEXT + ">" + str(t) + "</text>" for t in ticks)
    box = ("<line x1={:.1f} x2={:.1f} y1=49 y2=49 stroke='#9ea4bc' stroke-width=2 />".format(X(pc[0]), X(pc[4]))
           + "<rect x={:.1f} y=32 width={:.1f} height=34 rx=3 fill='#1bd8f4' fill-opacity=.35 stroke='#1bd8f4'/>".format(X(pc[1]), max(2, X(pc[3]) - X(pc[1])))
           + "<line x1={0:.1f} x2={0:.1f} y1=28 y2=70 stroke='#f7931a' stroke-width=3 />".format(X(pc[2]))
           + "<text x={:.1f} y=14 text-anchor=middle ".format(X(pc[2])) + SVG_TEXT + ">median " + "{:g}".format(round(pc[2], 1)) + "</text>"
           + "<text x={:.1f} y=14 text-anchor=middle ".format(X(pc[0])) + SVG_TEXT + ">10% " + "{:g}".format(round(pc[0], 1)) + "</text>"
           + "<text x={:.1f} y=14 text-anchor=middle ".format(X(pc[4])) + SVG_TEXT + ">90% " + "{:g}".format(round(pc[4], 1)) + "</text>")
    return "<div class=chart><h2>Fee rates paid (sat/vB, log scale)</h2><svg viewBox='0 0 520 100' role=img aria-label='Fee rate range'>" + g + box + "</svg></div>"


