def page(title, body):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>" + html.escape(title) + " · " + NAME + " explorer</title><style>" + CSS + "</style></head><body>"
            "<header><a class=brand href='/'>" + html.escape(NAME) + " <span>explorer</span></a>"
            "<a href='/forks' class=muted>Forks</a><form action='/search'><input name=q placeholder='Block height, block hash, transaction id or address' aria-label=Search>"
            "<button>Search</button></form></header><main>" + body + "</main>"
            "<footer>Read from your own " + ("Bitcoin Knots" if CHAIN == "blake2b" else "Bitcoin") + " node · hashes.space</footer></body></html>")


def btc(sats):
    return "{:,.8f}".format(sats / 1e8).rstrip("0").rstrip(".") + " " + COIN


def ago(t):
    s = max(0, int(time.time() - t))
    return str(s) + "s ago" if s < 60 else str(s // 60) + "m ago" if s < 3600 else str(s // 3600) + "h ago" if s < 86400 else str(s // 86400) + "d ago"


def svg_chart(rows, key, title, unit, fmt, color):
    """a small server-side line chart of one value per block (oldest left)"""
    vals = [r_[key] for r_ in rows]
    if len(vals) < 2:
        return ""
    w, h, pad = 520, 150, 34
    lo, hi = min(vals), max(vals)
    span = (hi - lo) or 1
    pts = " ".join("{:.1f},{:.1f}".format(pad + i * (w - pad - 8) / (len(vals) - 1), 10 + (h - 30) * (1 - (v - lo) / span)) for i, v in enumerate(vals))
    return ("<div class=chart><h2>" + html.escape(title) + "</h2><svg viewBox='0 0 " + str(w) + " " + str(h) + "' role=img aria-label='" + html.escape(title) + "'>"
            "<polyline fill=none stroke='" + color + "' stroke-width=1.6 points='" + pts + "'/>"
            "<text x=2 y=16 fill=currentColor font-size=12.5>" + fmt(hi) + "</text><text x=2 y=" + str(h - 22) + " fill=currentColor font-size=12.5>" + fmt(lo) + "</text>"
            "<text x=" + str(pad) + " y=" + str(h - 6) + " fill=currentColor font-size=12.5>" + "{:,}".format(rows[0]["height"]) + "</text>"
            "<text x=" + str(w - 8) + " y=" + str(h - 6) + " text-anchor=end fill=currentColor font-size=12.5>" + "{:,}".format(rows[-1]["height"]) + " · " + unit + "</text></svg></div>")


def charts():
    rows = STATS.history_rows()
    if len(rows) < 2:
        return "<section class=card><h2>Charts</h2><p class=muted>The size and fee charts fill in as the node's statistics are read (a few minutes after start).</p></section>"
    return ("<h2 class=sec>The last " + str(len(rows)) + " blocks the node keeps</h2><div class='charts diagrams'>"
            + svg_chart(rows, "size", "Block size", "MB", lambda v: "{:.2f}".format(v / 1e6), "#f7931a")
            + svg_chart(rows, "medianFeeRate", "Median fee rate", "sat/vB", lambda v: "{:g}".format(round(v, 1)), "#3ce26b")
            + svg_chart(rows, "totalFees", "Fees per block", COIN, lambda v: "{:.3f}".format(v / 1e8), "#1bd8f4")
            + svg_chart(rows, "txs", "Transactions per block", "txs", lambda v: "{:,}".format(v), "#f2b53c") + "</div>")


def forks_page():
    rows = ""
    for t in chain_tips():
        rows += ("<tr><td class=r>" + "{:,}".format(t["height"]) + "</td><td class=mono><a href='/block/" + t["hash"] + "'>" + t["hash"][:20] + "…</a></td><td>" + html.escape(t["status"])
                 + "</td><td class=r>" + str(t["branchLength"]) + "</td><td class=muted>" + (ago(t["timestamp"]) if t["timestamp"] else "") + "</td></tr>")
    return page("Forks", "<h1>Chain forks and stale blocks</h1><section class=card><table><tr><th class=r>Tip height</th><th>Tip hash</th><th>Status</th><th class=r>Branch length</th><th>Mined</th></tr>"
                + rows + "</table></section><section class=card><p class=muted>The node lists every chain tip it has seen. <b>active</b> is the chain it follows; the others are blocks that were mined but lost the race "
                "(<b>valid-fork</b>, <b>valid-headers</b>, <b>headers-only</b>) or were rejected (<b>invalid</b>). A branch length of 1 is a single stale block.</p></section>")


def address_page(addr):
    st = address_scan(addr)
    if st["state"] == "done":
        r_ = st["result"]
        rows = "".join("<tr><td class='mono wrap'><a href='/tx/" + u["txid"] + "'>" + u["txid"][:20] + "…</a>:" + str(u["vout"]) + "</td><td class=r>" + (("{:,}".format(u["height"])) if u["height"] else "") + "</td><td class=r>" + btc(u["value"]) + "</td></tr>" for u in r_["unspents"])
        return page("Address", "<h1>Address</h1><section class=card><dl><dt>Address</dt><dd class=mono>" + html.escape(addr) + "</dd><dt>Balance</dt><dd><b>" + btc(r_["balance"]) + "</b></dd><dt>Unspent outputs</dt><dd>"
                    + "{:,}".format(r_["unspentCount"]) + "</dd><dt>Scanned at block</dt><dd>" + "{:,}".format(r_["scannedAtHeight"] or 0) + "</dd></dl></section>"
                    "<section class=card><h2>Unspent outputs</h2><table><tr><th>Output</th><th class=r>Block</th><th class=r>Value</th></tr>" + rows + "</table></section>"
                    "<section class=card><p class=muted>Read from the node's UTXO set. It shows what the address holds now, not its history: a node keeps no address index.</p></section>")
    if st["state"] == "error":
        return page("Address", "<h1>Address</h1><section class='card err'>" + html.escape(st["error"]) + "</section>")
    wait = ("The node is scanning another address; this page tries again by itself." if st["state"] == "busy" else "The node is reading its whole UTXO set for this address. This takes a few minutes; the result is kept for 10 minutes.")
    return page("Address", "<meta http-equiv=refresh content=10><h1>Address</h1><section class=card><p class=mono>" + html.escape(addr) + "</p><p>" + wait + "</p></section>")


def tx_extras(txid):
    """mempool projection (block, ETA, CPFP, replaceability) as table rows; none for a confirmed transaction"""
    try:
        pr = tx_projection(txid)
    except Exception:  # noqa: BLE001
        return []
    where = ("Block " + str(pr["projectedBlock"] + 1) + " of the projection · about " + str(pr["etaMinutes"]) + " min") if pr["projectedBlock"] is not None else \
        "Not in the first " + str(len(STATE["mempool"])) + " blocks; needs more than " + "{:g}".format(pr["minFeeOfLastProjected"] or 0) + " sat/vB"
    rbf = "Yes: signals replaceability (BIP125)" if pr["signalsRbf"] else ("Yes: this node replaces without signalling (full RBF)" if pr["nodeReplacesWithoutSignal"] else "No: does not signal replaceability")
    rows = [("Projected", where), ("Effective fee rate", "{:g}".format(pr["effectiveFeeRate"]) + " sat/vB" + (" (the package it belongs to pays more)" if pr["effectiveFeeRate"] > pr["feeRate"] else "")),
            ("Unconfirmed parents / children", str(pr["ancestors"]) + " / " + str(pr["descendants"])), ("Can be replaced", rbf), ("In the mempool for", ago(time.time() - pr["age"]).replace(" ago", ""))]
    return rows


def old_tx_page(txid):
    found = spent_or_pruned_tx(txid)
    if not found:
        raise ValueError("Transaction not found. This node is pruned: it knows transactions in its mempool, in the blocks it still keeps, and any with an unspent output; "
                         "a transaction whose outputs are all spent and whose block is pruned cannot be read. Open it from its block, or use a full-node explorer.")
    rows = "".join("<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + html.escape(out_label(o)) + "</td><td class=r>"
                   + btc(round(float(o["value"]) * 1e8)) + "</td><td class=r>" + "{:,}".format(o.get("confirmations", 0)) + "</td></tr>" for n, o in found)
    return page("Transaction", "<h1>Transaction</h1><section class=card><dl><dt>Txid</dt><dd class=mono>" + txid + "</dd></dl></section><section class=card><h2>Unspent outputs</h2><table>"
                "<tr><th>#</th><th>Address</th><th class=r>Value</th><th class=r>Confirmations</th></tr>" + rows + "</table></section><section class=card><p class=muted>This node is pruned and no longer has the "
                "block of this transaction, so only its outputs that are still unspent are shown (from the UTXO set). Its inputs and fee are not available.</p></section>")


def home():
    with STATE_LOCK:
        err, info, count, blocks, projected = STATE["error"], STATE["info"], STATE["mempool_count"], STATE["blocks"], STATE["mempool"]
    if not info:
        try:
            info = NODE.call("getblockchaininfo")
        except Exception as exc:  # noqa: BLE001
            err = err or str(exc)
    state = ("<div class='card err'>The explorer is not serving the page's live stream yet: " + html.escape(err) + ". The Find Mempool page shows simulated blocks until this clears.</div>"
             if err else "<div class='card ok'>Live: the Find Mempool page reads its " + NAME + " blocks from this node.</div>")
    rows = "".join(
        "<tr><td><a href='/block/" + b["id"] + "'>" + "{:,}".format(b["height"]) + "</a></td><td class=muted>" + ago(b["timestamp"]) + "</td><td>"
        + html.escape(b["extras"]["pool"]["name"]) + "</td><td class=r>" + "{:,}".format(b["tx_count"]) + "</td><td class=r>" + "{:,.2f}".format(b["size"] / 1e6) + " MB</td><td class=r>"
        + "~" + "{:g}".format(round(b["extras"]["medianFee"], 1)) + " sat/vB</td><td class=r>" + btc(b["extras"]["totalFees"]) + "</td></tr>" for b in blocks)
    prow = "".join("<tr><td>" + ("Next block" if i == 0 else "+" + str(i)) + "</td><td class=r>" + "{:,}".format(p["nTx"]) + "</td><td class=r>"
                   + "{:,.2f}".format(p["blockVSize"] / 1e6) + " MvB</td><td class=r>~" + "{:g}".format(p["medianFee"]) + " sat/vB</td></tr>" for i, p in enumerate(projected))
    stats = [("Block height", "{:,}".format(info.get("blocks", 0))), ("Mempool", "{:,} txs".format(count)),
             ("Node sync", "{:.2f}%".format(info.get("verificationprogress", 0) * 100)), ("Node", "pruned" if info.get("pruned") else "full")]
    try:                                   # what else the node knows: the difficulty period, fees, the halving and its peers
        da, fees, hv, net = difficulty_adjustment(), recommended_fees(), halving(), network()
        stats += [("Next difficulty", "{:+.2f}%".format(da["difficultyChange"]) + " in " + "{:,}".format(da["remainingBlocks"]) + " blocks"),
                  ("Difficulty period", "{:.1f}% done".format(da["progressPercent"])),
                  ("Fees now", "{:g}".format(fees["fastestFee"]) + " / " + "{:g}".format(fees["hourFee"]) + " / " + "{:g}".format(fees["economyFee"]) + " sat/vB"),
                  ("Next halving", "{:,}".format(hv["remainingBlocks"]) + " blocks"),
                  ("Peers", "{:,}".format(net.get("connections") or 0)), ("Mempool size", "{:,.1f} MvB".format(net["mempool"]["vsize"] / 1e6))]
    except Exception:  # noqa: BLE001
        pass
    return page("Latest blocks", "<h1>" + html.escape(NAME) + "</h1>" + state + "<div class=stats>"
                + "".join("<div class='card stat'><span class=muted>" + k + "</span><b>" + v + "</b></div>" for k, v in stats)
                + "</div><section class=card><h2>Latest blocks</h2><table><tr><th>Height</th><th>Mined</th><th>Pool</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th><th class=r>Fees</th></tr>"
                + rows + "</table></section><section class=card><h2>Mempool, in blocks of 1 MvB</h2><table><tr><th>Block</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th></tr>"
                + prow + "</table></section>" + charts())


