def page(title, body):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>" + html.escape(title) + " · " + NAME + " explorer</title><style>" + CSS + "</style></head><body>"
            "<header><a class=brand href='/'>" + html.escape(NAME) + " <span>explorer</span></a>"
            "<form action='/search'><input name=q placeholder='Block height, block hash or transaction id' aria-label=Search>"
            "<button>Search</button></form></header><main>" + body + "</main>"
            "<footer>Read from your own " + ("Bitcoin Knots" if CHAIN == "blake2b" else "Bitcoin") + " node · hashes.space</footer></body></html>")


def btc(sats):
    return "{:,.8f}".format(sats / 1e8).rstrip("0").rstrip(".") + " " + COIN


def ago(t):
    s = max(0, int(time.time() - t))
    return str(s) + "s ago" if s < 60 else str(s // 60) + "m ago" if s < 3600 else str(s // 3600) + "h ago" if s < 86400 else str(s // 86400) + "d ago"


def home():
    with STATE_LOCK:
        err, info, count, blocks, projected = STATE["error"], STATE["info"], STATE["mempool_count"], STATE["blocks"], STATE["mempool"]
    if not info:
        try:
            info = NODE.call("getblockchaininfo")
        except Exception as exc:  # noqa: BLE001
            err = err or str(exc)
    state = ("<div class='card err'>The explorer is not serving the page's live stream yet: " + html.escape(err) + ". The Find Mempool page uses " + OTHER + " until this clears.</div>"
             if err else "<div class='card ok'>Live: the Find Mempool page reads its " + NAME + " blocks from this node.</div>")
    rows = "".join(
        "<tr><td><a href='/block/" + b["id"] + "'>" + "{:,}".format(b["height"]) + "</a></td><td class=muted>" + ago(b["timestamp"]) + "</td><td>"
        + html.escape(b["extras"]["pool"]["name"]) + "</td><td class=r>" + "{:,}".format(b["tx_count"]) + "</td><td class=r>" + "{:,.2f}".format(b["size"] / 1e6) + " MB</td><td class=r>"
        + "~" + "{:g}".format(round(b["extras"]["medianFee"], 1)) + " sat/vB</td><td class=r>" + btc(b["extras"]["totalFees"]) + "</td></tr>" for b in blocks)
    prow = "".join("<tr><td>" + ("Next block" if i == 0 else "+" + str(i)) + "</td><td class=r>" + "{:,}".format(p["nTx"]) + "</td><td class=r>"
                   + "{:,.2f}".format(p["blockVSize"] / 1e6) + " MvB</td><td class=r>~" + "{:g}".format(p["medianFee"]) + " sat/vB</td></tr>" for i, p in enumerate(projected))
    stats = [("Block height", "{:,}".format(info.get("blocks", 0))), ("Mempool", "{:,} txs".format(count)),
             ("Node sync", "{:.2f}%".format(info.get("verificationprogress", 0) * 100)), ("Node", "pruned" if info.get("pruned") else "full")]
    return page("Latest blocks", "<h1>" + html.escape(NAME) + "</h1>" + state + "<div class=stats>"
                + "".join("<div class='card stat'><span class=muted>" + k + "</span><b>" + v + "</b></div>" for k, v in stats)
                + "</div><section class=card><h2>Latest blocks</h2><table><tr><th>Height</th><th>Mined</th><th>Pool</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th><th class=r>Fees</th></tr>"
                + rows + "</table></section><section class=card><h2>Mempool, in blocks of 1 MvB</h2><table><tr><th>Block</th><th class=r>Txs</th><th class=r>Size</th><th class=r>Median fee</th></tr>"
                + prow + "</table></section>")


def block_page(ident):
    h = NODE.call("getblockhash", int(ident)) if ident.isdigit() else ident
    if not HEX64.fullmatch(h):
        raise ValueError("not a block")
    try:
        b = NODE.call("getblock", h, 2, timeout=120)
    except RuntimeError as exc:
        hd = NODE.call("getblockheader", h)       # the header is never pruned
        return page("Block " + str(hd["height"]), "<h1>Block " + "{:,}".format(hd["height"]) + "</h1><section class='card'><p>This node is pruned and has deleted the data of this block ("
                    + html.escape(str(exc)) + "). Its header: " + "<span class=mono>" + h + "</span>, mined " + time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(hd["time"]))
                    + ".</p><p><a href='https://" + OTHER + "/block/" + h + "'>Open it on " + OTHER + " →</a></p></section>")
    txs = b["tx"]
    fees = sum(round(float(t.get("fee", 0)) * 1e8) for t in txs[1:])
    cb = txs[0]
    nav = ("<a href='/block/" + b["previousblockhash"] + "'>← previous</a>" if b.get("previousblockhash") else "") + ("  ·  <a href='/block/" + b["nextblockhash"] + "'>next →</a>" if b.get("nextblockhash") else "")
    text = bytes.fromhex(cb["vin"][0].get("coinbase", "")).decode("latin-1")
    addrs = [o.get("scriptPubKey", {}).get("address") for o in cb.get("vout", []) if o.get("scriptPubKey", {}).get("address")]
    pool = POOLS.find(text, addrs)
    rows = ""
    for t in txs[:500]:
        outs = ", ".join(html.escape(o.get("scriptPubKey", {}).get("address") or "?") for o in t["vout"][:2]) + (" …" if len(t["vout"]) > 2 else "")
        rate = ("{:.1f}".format(float(t["fee"]) * 1e8 / t["vsize"]) + " sat/vB") if "fee" in t and t.get("vsize") and t is not cb else ""
        rows += ("<tr><td class=mono><a href='/tx/" + t["txid"] + "?b=" + h + "'>" + t["txid"][:16] + "…</a></td><td>" + ("coinbase" if t is cb else str(len(t["vin"])) + " in")
                 + "</td><td class='mono wrap'>" + outs + "</td><td class=r>" + btc(round(sum(float(o["value"]) for o in t["vout"]) * 1e8)) + "</td><td class=r>" + rate + "</td></tr>")
    more = "<p class=muted>Showing the first 500 of " + "{:,}".format(len(txs)) + " transactions.</p>" if len(txs) > 500 else ""
    return page("Block " + str(b["height"]), "<h1>Block " + "{:,}".format(b["height"]) + "</h1><p>" + nav + "</p><section class=card><dl>"
                + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in [
                    ("Hash", "<span class=mono>" + h + "</span>"), ("Mined", time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(b["time"])) + " (" + ago(b["time"]) + ")"),
                    ("Pool", html.escape(pool)), ("Transactions", "{:,}".format(len(txs))), ("Size", "{:,} bytes · {:,} weight units".format(b["size"], b["weight"])),
                    ("Fees", btc(fees)), ("Reward", btc(fees + (SUBSIDY0 >> (b["height"] // 210000)))),
                    ("Difficulty", "{:,.0f}".format(b.get("difficulty", 0))), ("Confirmations", "{:,}".format(b.get("confirmations", 0)))])
                + "</dl></section><section class=card><h2>Transactions</h2><table><tr><th>Txid</th><th>Inputs</th><th>To</th><th class=r>Out</th><th class=r>Fee rate</th></tr>"
                + rows + "</table>" + more + "</section>")


def tx_page(txid, block_hash):
    try:
        tx = NODE.call("getrawtransaction", txid, 2, *([block_hash] if block_hash else []))
    except RuntimeError:
        try:
            tx = NODE.call("getrawtransaction", txid, True, *([block_hash] if block_hash else []))
        except RuntimeError:
            raise ValueError("Transaction not found. A node finds a transaction that is in its mempool or in a block it still keeps; "
                             "open it from its block, or run the node with -txindex=1 (not possible on a pruned node).")
    ins = "".join("<tr><td class='mono wrap'>" + ("coinbase" if "coinbase" in i else "<a href='/tx/" + i["txid"] + "'>" + i["txid"][:16] + "…</a>:" + str(i["vout"])) + "</td></tr>" for i in tx["vin"])
    outs = "".join("<tr><td class=mono>" + str(n) + "</td><td class='mono wrap'>" + html.escape(o.get("scriptPubKey", {}).get("address") or o.get("scriptPubKey", {}).get("type", "")) + "</td><td class=r>"
                   + btc(round(float(o["value"]) * 1e8)) + "</td></tr>" for n, o in enumerate(tx["vout"]))
    bh = tx.get("blockhash")
    rows = [("Txid", "<span class=mono>" + tx["txid"] + "</span>"),
            ("Status", ("In block <a href='/block/" + bh + "'>" + bh[:16] + "…</a> · " + "{:,}".format(tx.get("confirmations", 0)) + " confirmations") if bh else "In the mempool, waiting for a block"),
            ("Size", "{:,} bytes · {:,} vB".format(tx["size"], tx["vsize"])), ("Total out", btc(round(sum(float(o["value"]) for o in tx["vout"]) * 1e8)))]
    if "fee" in tx:
        rows.append(("Fee", btc(round(float(tx["fee"]) * 1e8)) + " (" + "{:.1f}".format(float(tx["fee"]) * 1e8 / tx["vsize"]) + " sat/vB)"))
    return page("Transaction", "<h1>Transaction</h1><section class=card><dl>" + "".join("<dt>" + k + "</dt><dd>" + v + "</dd>" for k, v in rows)
                + "</dl></section><section class=card><h2>Inputs</h2><table>" + ins + "</table></section><section class=card><h2>Outputs</h2><table><tr><th>#</th><th>Address</th><th class=r>Value</th></tr>"
                + outs + "</table></section>")


class Handler(BaseHTTPRequestHandler):
    server_version = CHAIN + "-explorer"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="text/html; charset=utf-8", cache=0):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "public, max-age=" + str(cache) if cache else "no-store")
        self.end_headers()
        self.wfile.write(data)

    def json(self, obj, cache=0):
        self.send(200, json.dumps(obj), "application/json", cache)

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        params = dict(p.split("=", 1) for p in query.split("&") if "=" in p)
        try:
            if path == "/api/v1/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
                return self.websocket()
            if path == "/api/v1/blocks":
                return self.json([view(b) for b in need_live()[0]], 5)
            if path == "/api/v1/fees/mempool-blocks":
                return self.json(need_live()[1], 5)
            if path == "/api/blocks/tip/height":
                return self.send(200, str(need_live()[0][0]["height"]), "text/plain", 5)
            if path == "/api/v1/status":
                with STATE_LOCK:
                    s = {"live": not STATE["error"], "error": STATE["error"], "tip": STATE["blocks"][0]["height"] if STATE["blocks"] else None, "updated": STATE["at"],
                         "mempool": STATE["mempool_count"], "pruned": STATE["info"].get("pruned"), "node": STATE["info"].get("subversion"), "chain": CHAIN, "syncing": STATE["info"].get("initialblockdownload"),
                         "statistics": STATS.ready, "statisticsError": STATS.error, "pools": len(POOLS.tags) > 0}
                return self.json(s)
            m = re.fullmatch(r"/api/v1/mining/(hashrate|pools)/(24h|14d|1w|1m|3m|6m|1y)", path)
            if m:
                kind, period = m.groups()
                if kind == "hashrate":
                    return self.json(STATS.hashrate("14d" if period == "1w" else "1m" if period == "3m" else period), 300)
                return self.json(STATS.pools(period), 300)
            if path == "/":
                return self.send(200, home())
            if path.startswith("/block/"):
                return self.send(200, block_page(path[7:]))
            if path.startswith("/tx/") and HEX64.fullmatch(path[4:]):
                return self.send(200, tx_page(path[4:].lower(), params.get("b")))
            if path == "/search":
                q = urllib.request.unquote(params.get("q", "").replace("+", " ")).strip()
                if q.isdigit():
                    return self.redirect("/block/" + q)
                if HEX64.fullmatch(q):
                    try:
                        NODE.call("getblockheader", q)
                        return self.redirect("/block/" + q)
                    except RuntimeError:
                        return self.redirect("/tx/" + q.lower())
                return self.send(404, page("Not found", "<h1>Nothing found</h1><p>Search for a block height, a block hash or a transaction id.</p>"))
            return self.send(404, page("Not found", "<h1>Not found</h1>"))
        except (RuntimeError, ValueError, OSError, KeyError, IndexError) as exc:
            if path.startswith("/api/"):
                return self.send(503, json.dumps({"error": str(exc)}), "application/json")
            return self.send(502, page("Error", "<h1>Something went wrong</h1><p class=err>" + html.escape(str(exc)) + "</p>"))

    def redirect(self, to):
        self.send_response(302)
        self.send_header("Location", to)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def websocket(self):
        try:
            blocks, mempool = need_live()         # not live (node syncing, not answering): no upgrade, so the page uses another source at once
        except RuntimeError as exc:
            return self.send(503, json.dumps({"error": str(exc)}), "application/json")
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        sock = self.connection
        sock.settimeout(120)
        try:
            while True:
                head = self.rfile.read(2)
                if len(head) < 2:
                    break
                op, ln = head[0] & 0x0F, head[1] & 0x7F
                if ln == 126:
                    ln = struct.unpack(">H", self.rfile.read(2))[0]
                elif ln == 127:
                    ln = struct.unpack(">Q", self.rfile.read(8))[0]
                mask = self.rfile.read(4) if head[1] & 0x80 else b"\0\0\0\0"
                data = bytes(c ^ mask[i % 4] for i, c in enumerate(self.rfile.read(ln)))
                if op == 8:
                    break
                if op == 9:
                    with _send_lock:
                        sock.sendall(bytes([0x8A, len(data)]) + data)
                    continue
                if op != 1:
                    continue
                try:
                    msg = json.loads(data)
                except ValueError:
                    continue
                if msg.get("action") == "want":
                    with _clients_lock:
                        _clients.add(sock)
                    blocks, mempool = need_live()
                    ws_send(sock, json.dumps({"blocks": [view(b) for b in blocks], "mempool-blocks": mempool}))
                elif msg.get("action") == "ping":
                    ws_send(sock, json.dumps({"pong": True}))
        except (OSError, RuntimeError, ValueError):
            pass
        finally:
            with _clients_lock:
                _clients.discard(sock)
            self.close_connection = True


def main():
    threading.Thread(target=POOLS.load, daemon=True).start()
    threading.Thread(target=poller, daemon=True).start()
    threading.Thread(target=stats_worker, daemon=True).start()
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    server.daemon_threads = True
    log("node " + os.environ["RPC_HOST"] + ":" + os.environ.get("RPC_PORT", "8332") + ", listening on port " + str(PORT))
    server.serve_forever()


if __name__ == "__main__":
    main()
