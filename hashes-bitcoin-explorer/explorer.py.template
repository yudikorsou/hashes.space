class BtcRpc:
    """A bitcoind-style JSON-RPC client (Bitcoin Core, Bitcoin Knots) over one kept-open connection."""

    def __init__(self, host, port, user, password):
        self.host, self.port = host, int(port)
        self.auth = "Basic " + base64.b64encode((user + ":" + password).encode()).decode()
        self.conn, self.lock = None, threading.Lock()

    def call(self, method, *params, timeout=60):
        body = json.dumps({"jsonrpc": "1.0", "id": "hs", "method": method, "params": list(params)}).encode()
        with self.lock:
            for attempt in (1, 2):
                try:
                    if self.conn is None:
                        self.conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
                    self.conn.timeout = timeout
                    self.conn.request("POST", "/", body=body, headers={"Authorization": self.auth, "Content-Type": "application/json"})
                    r = self.conn.getresponse()
                    status, data = r.status, r.read()
                    break
                except (http.client.HTTPException, OSError):
                    try:
                        self.conn and self.conn.close()
                    except Exception:
                        pass
                    self.conn = None
                    if attempt == 2:
                        raise
        if status == 401:
            raise RuntimeError("the node refused the RPC login")
        out = json.loads(data)             # an RPC error comes back as HTTP 500 with the error in the JSON
        if out.get("error"):
            raise RuntimeError(str(out["error"].get("message", out["error"])))
        return out["result"]


def bits_work(bits_hex):
    """The hashes one block takes on average at this target (the compact 'bits' of a header)."""
    b = int(bits_hex, 16)
    exp, mant = b >> 24, b & 0x7FFFFF
    target = mant << (8 * (exp - 3)) if exp > 3 else mant >> (8 * (3 - exp))
    return (1 << 256) // (target + 1) if target > 0 else 0


def percentiles(rates):
    """[lowest, 10%, 25%, median, 75%, 90%, highest] of a list of fee rates, as mempool's feeRange."""
    if not rates:
        return [0, 0, 0, 0, 0, 0, 0]
    r = sorted(rates)
    at = lambda q: r[min(len(r) - 1, int(q * len(r)))]
    return [r[0], at(.1), at(.25), at(.5), at(.75), at(.9), r[-1]]


class PoolList:
    """Which pool wrote a coinbase: payout addresses first, then the tags a pool puts in its coinbase text."""

    def __init__(self):
        self.addresses, self.tags, self.loaded = {}, [], False

    def load(self):
        entries = []
        if CHAIN == "blake2b":
            self.loaded, entries = True, [(n, t, []) for n, t in B2_POOLS]
        else:
            try:
                req = urllib.request.Request(POOLS_URL, headers={"User-Agent": "hashes.space"})
                with urllib.request.urlopen(req, timeout=30) as r:
                    for e in json.loads(r.read()):
                        entries.append((e["name"], e.get("tags") or [], e.get("addresses") or []))
                self.loaded = True
            except Exception as exc:
                log("pool list: " + str(exc) + " (using the short built-in list)")
                entries = [(n, t, []) for n, t in FALLBACK_POOLS]
            known = {n.lower() for n, _, _ in entries}
            entries += [(n, t, []) for n, t in FALLBACK_POOLS if n.lower() not in known]
        self.addresses, self.tags = {}, []
        for name, tags, addrs in entries:
            for a in addrs:
                self.addresses[a] = name
            for t in tags:
                try:
                    self.tags.append((re.compile(t, re.I), name))
                except re.error:
                    pass

    @staticmethod
    def miner_after(text, m):
        """The miner a pool names in its coinbase: the printable text right after the pool's own tag ("AlphaPool", "Grumpy Pickle")."""
        runs = [x for x in re.finditer(r"[\x20-\x7e]+", text)]
        for k, run in enumerate(runs):
            if run.start() <= m.start() < run.end():
                if k + 1 < len(runs):
                    cand = runs[k + 1].group().strip()
                    if 2 <= len(cand) <= 40 and re.search(r"[A-Za-z0-9]{2}", cand) and cand.lower() not in run.group().lower() and m.group().lower() not in cand.lower():
                        return cand
                break
        return ""

    def find_full(self, coinbase_text, addresses):
        """(pool, miner) of a coinbase"""
        for a in addresses:
            if a in self.addresses:
                return self.addresses[a], ""
        for rx, name in self.tags:
            m = rx.search(coinbase_text)
            if m:
                miner = self.miner_after(coinbase_text, m)
                return name, ("" if miner.lower() == name.lower() else miner)
        return "Unknown", ""

    def find(self, coinbase_text, addresses):
        return self.find_full(coinbase_text, addresses)[0]


POOLS = PoolList()


SHARE_FILE = os.path.join(os.environ.get("STATE_DIR", "/state"), "pool-shares-" + CHAIN + ".json")


def load_shares():
    try:
        with open(SHARE_FILE) as f:
            return {int(d): [int(v[0]), int(v[1])] for d, v in json.load(f).items()}
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return {}


def save_shares(days):
    try:
        tmp = SHARE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({str(d): v for d, v in sorted(days.items())[-400:]}, f)
        os.replace(tmp, SHARE_FILE)
    except OSError as exc:
        log("pool shares cannot be kept on disk (" + str(exc) + "): the history then restarts with the node's readable blocks")


class ChainStats:
    def __init__(self, name, rpc):
        self.name, self.rpc, self.lock = name, rpc, threading.Lock()
        self.headers = {}                  # height -> (time, chainwork, hashes per block, difficulty)
        self.pool_of = {}                  # height -> pool name
        self.pool_rows = {}                # height -> the block as the pool view lists it
        self.history = {}                  # height -> block size, fees and fee rates (getblockstats), for the charts
        self.miner_of = {}                 # height -> the miner the pool names in the coinbase ("" when it names none)
        self.share_day = load_shares()     # day number -> [blocks mined by pools, blocks that day]: kept on disk, so it outlives what a pruned node can still read
        self.tip, self.fine, self.coarse, self.now = None, [], [], (0, 0)
        self.ready, self.pruned_at, self.error = False, None, ""
        self.live_blocks, self.live = {}, None     # block hash -> the block as shown; the latest live view

    def header(self, h):
        hit = self.headers.get(h)
        if hit:
            return hit
        hd = self.rpc.call("getblockheader", self.rpc.call("getblockhash", h))
        bits_w = bits_work(hd["bits"])
        # the BLAKE2b chain's headers may carry no "difficulty": the hashes a block takes (from "bits") is what the page shows for it
        hit = (int(hd["time"]), int(hd["chainwork"], 16), bits_w, float(hd["difficulty"]) if hd.get("difficulty") is not None else float(bits_w))
        self.headers[h] = hit
        return hit

    def _series(self, heights):
        hs, ds, last = [], [], None
        for a, b in zip(heights, heights[1:]):
            ta, wa, _, _ = self.header(a)
            tb, wb, work, diff = self.header(b)
            if tb > ta and wb > wa:
                hs.append((tb, (wb - wa) / (tb - ta)))
            d = work if self.name == "blake2b" else diff   # BLAKE2b: the hashes a block takes
            if d != last:
                ds.append((tb, d))
                last = d
        return hs, ds

    def refresh_hashrate(self):
        tip = int(self.rpc.call("getblockcount"))
        step_f, step_c = 18, BTC_BLOCKS_PER_DAY                  # 3 hours for the month, a day for the year
        grid = lambda step, n: sorted({max(1, (tip // step - i) * step) for i in range(n, -1, -1)} | {tip})
        fine, coarse = self._series(grid(step_f, 30 * 8)), self._series(grid(step_c, 366))
        a, b = self.header(max(1, tip - BTC_BLOCKS_PER_DAY)), self.header(tip)
        rate = (b[1] - a[1]) / (b[0] - a[0]) if b[0] > a[0] else 0
        with self.lock:
            self.tip, self.fine, self.coarse = tip, fine, coarse
            self.now = (rate, b[2] if self.name == "blake2b" else b[3])
            self.ready = True
        # forget what is out of reach, so the cache stays small
        for h in [h for h in self.headers if h < tip - 400 * BTC_BLOCKS_PER_DAY]:
            del self.headers[h]

    def classify(self, h):
        block_hash = self.rpc.call("getblockhash", h)
        txid = self.rpc.call("getblock", block_hash, 1)["tx"][0]
        tx = self.rpc.call("getrawtransaction", txid, True, block_hash)
        text = bytes.fromhex(tx["vin"][0].get("coinbase", "")).decode("latin-1")
        addrs = []
        for o in tx.get("vout", []):
            sp = o.get("scriptPubKey", {})
            addrs += [sp["address"]] if sp.get("address") else (sp.get("addresses") or [])
        self.header(h)
        return POOLS.find_full(text, addrs)

    def refresh_pools(self):
        tip = self.tip
        for h in range(tip, max(1, tip - POOL_BLOCKS) - 1, -1):    # newest first, so the day and the week are ready early
            if h in self.pool_of:
                continue
            try:
                self.pool_of[h], self.miner_of[h] = self.classify(h)
            except Exception as exc:
                if self.pruned_at is None:
                    log(self.name + ": block " + str(h) + " cannot be read (" + str(exc) + "): the pool split covers the blocks from " + str(h + 1))
                self.pruned_at = h
                break
        for h in [h for h in self.pool_of if h < tip - POOL_BLOCKS]:
            del self.pool_of[h]
            self.miner_of.pop(h, None)

    # ---- the live block stream: the newest blocks and the blocks the mempool would build, straight from the node ----
    # The same shape as mempool's websocket ("blocks" and "mempool-blocks"), so the page reads either one.
    def block_view(self, hash_):
        """One block as the page shows it: size, fees (from the node's own undo data) and the pool that mined it."""
        hit = self.live_blocks.get(hash_)
        if hit:
            return hit
        b = self.rpc.call("getblock", hash_, 2, timeout=120)
        txs = b["tx"]
        cb = txs[0]
        text = bytes.fromhex(cb["vin"][0].get("coinbase", "")).decode("latin-1")
        addrs = []
        for o in cb.get("vout", []):
            sp = o.get("scriptPubKey", {})
            addrs += [sp["address"]] if sp.get("address") else (sp.get("addresses") or [])
        rates, fees = [], 0
        for t in txs[1:]:
            if "fee" in t and t.get("vsize"):
                f = round(float(t["fee"]) * 1e8)
                fees += f
                rates.append(f / t["vsize"])
        if not rates and len(txs) > 1:     # no undo data for this block: the fees are what the coinbase claims above the subsidy
            subsidy = int(50e8) >> (int(b["height"]) // 210000)
            fees = max(0, round(sum(float(o["value"]) for o in cb["vout"]) * 1e8) - subsidy)
        view = {"id": b["hash"], "height": int(b["height"]), "timestamp": int(b["time"]), "tx_count": int(b["nTx"]),
                "size": int(b["size"]), "weight": int(b["weight"]), "previousblockhash": b.get("previousblockhash"),
                "extras": {"medianFee": percentiles(rates)[3], "feeRange": percentiles(rates), "totalFees": fees,
                           "pool": {"name": POOLS.find(text, addrs)}, "coinbaseRaw": cb["vin"][0].get("coinbase", "")}}
        self.live_blocks[hash_] = view
        return view

    def refresh_live_blocks(self):
        if not POOLS.tags:
            raise RuntimeError("the list of mining pools is still loading")
        info = self.rpc.call("getblockchaininfo")
        if info.get("initialblockdownload"):
            raise RuntimeError("the node is still syncing")
        tip, out = info["bestblockhash"], []
        h = tip
        while h and len(out) < 8:
            v = self.block_view(h)
            out.append(v)
            h = v["previousblockhash"]
        for k in [k for k in self.live_blocks if k not in {v["id"] for v in out}]:
            if len(self.live_blocks) > 24:
                del self.live_blocks[k]
        return [{k: x for k, x in v.items() if k != "previousblockhash"} for v in out]

    def refresh_live_mempool(self):
        pool = self.rpc.call("getrawmempool", True, timeout=180)
        items = []
        for e in pool.values():
            v = e.get("vsize") or e.get("size") or 0
            if not v:
                continue
            f = e.get("fees", {})
            base = float(f.get("base", e.get("fee", 0))) * 1e8
            # a transaction is mined together with the parents it needs and the children that pay for it:
            # its worth to a miner is the best of its own rate and its packages' rates
            rate = max(base / v, float(f.get("ancestor", 0)) * 1e8 / max(1, e.get("ancestorsize", v)),
                       float(f.get("descendant", 0)) * 1e8 / max(1, e.get("descendantsize", v)))
            items.append((rate, v, base))
        items.sort(key=lambda x: -x[0])
        blocks, cur, size = [], [], 0
        def flush():
            rates = [r for r, _, _ in cur]
            blocks.append({"nTx": len(cur), "blockVSize": size, "medianFee": round(percentiles(rates)[3], 2),
                           "feeRange": [round(x, 2) for x in percentiles(rates)], "totalFees": round(sum(b for _, _, b in cur))})
        for it in items:
            if size + it[1] > 1_000_000 and cur:
                flush()
                cur, size = [], 0
                if len(blocks) >= 8:
                    break
            cur.append(it)
            size += it[1]
        if cur and len(blocks) < 8:
            flush()
        return blocks, len(pool)

    def refresh_live(self):
        blocks = self.refresh_live_blocks()
        try:
            mb, count = self.refresh_live_mempool()
        except Exception as exc:           # blocks are still worth showing when the mempool cannot be read right now
            log(self.name + " mempool: " + str(exc))
            mb, count = (self.live or {}).get("mempoolBlocks", []), 0
        with self.lock:
            self.live = {"blocks": blocks, "mempoolBlocks": mb, "mempoolCount": count, "tip": blocks[0]["height"], "updated": int(time.time())}

    def hashrate(self, period):
        with self.lock:
            if not self.ready:
                raise RuntimeError("no data yet")
            (fine_h, fine_d), (coarse_h, coarse_d), (rate, diff) = self.fine, self.coarse, self.now
        span = {"24h": DAY, "14d": 14 * DAY, "epoch": 14 * DAY, "1m": 30 * DAY, "6m": 183 * DAY, "1y": YEAR}[period]
        hs, ds = (fine_h, fine_d) if span <= 30 * DAY else (coarse_h, coarse_d)
        cut = hs[-1][0] - span if hs else 0
        if period == "epoch":              # since the last difficulty adjustment: the first block of the current 2016-block period
            cut = self.header(max(1, self.tip - self.tip % EPOCH))[0]
        if period == "14d":                # the last difficulty period (2016 blocks), not a fixed 14 days
            cut = self.header(max(1, self.tip - EPOCH))[0]
        keep = [x for x in hs if x[0] >= cut]
        before = [x for x in ds if x[0] < cut][-1:]
        return {"currentHashrate": rate, "currentDifficulty": diff,
                "hashrates": [{"timestamp": t, "avgHashrate": v} for t, v in keep],
                "difficulty": [{"time": t, "difficulty": d} for t, d in before + [x for x in ds if x[0] >= cut]]}

    def refresh_history(self):
        """block size, fees and fee rates of the newest HISTORY_BLOCKS blocks, newest first: a pruned node stops where its blocks end"""
        tip = self.tip
        for h in range(tip, max(1, tip - HISTORY_BLOCKS) - 1, -1):
            if h in self.history:
                continue
            try:
                st = self.rpc.call("getblockstats", h, ["time", "txs", "total_size", "total_weight", "totalfee", "feerate_percentiles", "swtxs", "total_out"], timeout=120)
            except Exception:  # noqa: BLE001
                break
            self.history[h] = {"height": h, "timestamp": st["time"], "txs": st["txs"], "size": st["total_size"], "weight": st["total_weight"],
                               "totalFees": st["totalfee"], "medianFeeRate": (st.get("feerate_percentiles") or [0, 0, 0])[2], "swShare": round(st["swtxs"] / st["txs"], 4) if st["txs"] else 0,
                               "totalOut": st["total_out"]}
        for h in [h for h in self.history if h < tip - HISTORY_BLOCKS]:
            del self.history[h]

    def history_rows(self):
        with self.lock:
            return [self.history[h] for h in sorted(self.history)]

    def pool_blocks(self, slug, limit=40, epoch=False, budget=None):
        """The latest blocks of one pool, in mempool's format (id, height, timestamp, tx_count, size, extras with the median fee and fee range).
        epoch=True: every block of the pool since the last difficulty adjustment (the first block of the current 2016-block period), newest first;
        when a new adjustment starts the list starts again from it. Blocks not read yet are read within
        `budget` seconds and the rest follow on the next request, so a first request never hangs."""
        with self.lock:
            hs = {h: p for h, p in self.pool_of.items() if re.sub(r"[^a-z0-9]+", "-", p.lower()).strip("-") == slug}
            top = max(self.pool_of) if self.pool_of else 0
        heights = sorted((h for h in hs if not epoch or h >= top - top % EPOCH), reverse=True)
        if not epoch:
            heights = heights[:limit]
        deadline = time.time() + budget if budget else None
        out = []
        for h in heights:
            row = self.pool_rows.get(h)
            if row is None or (epoch and "extras" not in row):
                if deadline and time.time() > deadline:
                    break
                try:
                    bh = row["id"] if row else self.rpc.call("getblockhash", h)
                    if row is None:
                        b = self.rpc.call("getblock", bh, 1, timeout=120)
                        row = {"id": bh, "height": h, "timestamp": int(b["time"]), "tx_count": int(b["nTx"]), "size": int(b["size"]), "weight": int(b.get("weight", int(b["size"]) * 4))}
                    if epoch:
                        try:
                            st = self.rpc.call("getblockstats", h, ["feerate_percentiles", "minfeerate", "maxfeerate"], timeout=120)
                            pc = st.get("feerate_percentiles") or [0, 0, 0, 0, 0]
                            row["extras"] = {"medianFee": pc[2], "feeRange": [st.get("minfeerate", 0), pc[0], pc[1], pc[2], pc[3], pc[4], st.get("maxfeerate", 0)]}
                        except Exception:  # noqa: BLE001
                            row["extras"] = {"medianFee": 0, "feeRange": [0, 0]}
                except Exception:  # noqa: BLE001
                    continue                       # pruned since: the block is simply left out
                self.pool_rows[h] = row
            out.append(row)
        for h in [h for h in self.pool_rows if h not in self.pool_of]:
            del self.pool_rows[h]
        return out

    def pool_split(self, rows):
        """rows: [(pool, miner)] -> the pools with their blocks and, inside each pool, the miners it names"""
        count, miners = {}, {}
        for pool, miner in rows:
            count[pool] = count.get(pool, 0) + 1
            if miner:
                m = miners.setdefault(pool, {})
                m[miner] = m.get(miner, 0) + 1
        out = []
        for n, c in sorted(count.items(), key=lambda x: -x[1]):
            e = {"name": n, "slug": re.sub(r"[^a-z0-9]+", "-", n.lower()).strip("-"), "blockCount": c}
            if n in miners:
                e["miners"] = [{"name": k, "blockCount": v} for k, v in sorted(miners[n].items(), key=lambda x: -x[1])]
            out.append(e)
        return out

    def update_shares(self):
        """per day: how many blocks pools mined. The oldest day read is partial, so it is left out; a day is only ever replaced by a fuller count."""
        with self.lock:
            rows = [(h, p) for h, p in self.pool_of.items() if h in self.headers]
        if not rows:
            return
        days = {}
        for h, p in rows:
            d = self.headers[h][0] // DAY
            c = days.setdefault(d, [0, 0])
            c[1] += 1
            if p != "Unknown":
                c[0] += 1
        oldest = min(days)
        changed = False
        for d, (pool, total) in days.items():
            if d == oldest and self.pruned_at is not None or d == oldest and len(rows) >= POOL_BLOCKS:
                continue                  # cut off by the pruned blocks or by POOL_BLOCKS: part of the day is missing
            old = self.share_day.get(d)
            if not old or total >= old[1]:
                if old != [pool, total]:
                    self.share_day[d] = [pool, total]
                    changed = True
        if changed:
            save_shares(self.share_day)

    def pool_hashrate(self, period):
        """the hashrate of the mining pools together: the network's hashrate that day times the share of that day's blocks that pools mined.
        period "epoch": the blocks since the last difficulty adjustment (the current 2016-block period) give the share"""
        if period == "epoch":
            with self.lock:
                if not self.ready or not self.pool_of:
                    raise RuntimeError("no data yet")
                rate = self.now[0]
                top = max(self.pool_of)
                start = top - top % EPOCH
                ep = [p for h, p in self.pool_of.items() if h >= start]
            if not ep:
                raise RuntimeError("no data yet")
            share = sum(1 for p in ep if p != "Unknown") / len(ep)
            return {"currentHashrate": rate * share, "currentShare": share, "networkHashrate": rate, "since": self.header(start)[0], "complete": True,
                    "epochStart": start, "nextAdjustment": start + EPOCH, "blockCount": len(ep), "hashrates": []}
        with self.lock:
            if not self.ready:
                raise RuntimeError("no data yet")
            (fine, coarse, (rate, _)) = self.fine[0], self.coarse[0], self.now
            days = dict(self.share_day)
        span = {"24h": DAY, "14d": 14 * DAY, "1m": 30 * DAY, "6m": 183 * DAY, "1y": YEAR}[period]
        series = fine if span <= 30 * DAY and fine else coarse
        if not days or not series:
            raise RuntimeError("no data yet")
        end = series[-1][0]

        def network_at(t):
            lo, hi = 0, len(series) - 1
            if t <= series[0][0]:
                return series[0][1]
            while hi - lo > 1:
                mid = (lo + hi) // 2
                lo, hi = (mid, hi) if series[mid][0] <= t else (lo, mid)
            (ta, va), (tb, vb) = series[lo], series[hi]
            return va + (vb - va) * (t - ta) / (tb - ta) if tb > ta else va
        points = []
        for d in sorted(days):
            t = d * DAY + DAY // 2
            pool, total = days[d]
            if total < 20 or t > end or t < end - span:
                continue
            share = pool / total
            points.append({"timestamp": t, "avgHashrate": network_at(t) * share, "share": share, "networkHashrate": network_at(t)})
        if not points:
            raise RuntimeError("no data yet")
        recent = [days[d] for d in sorted(days)[-7:]]
        share_now = sum(x[0] for x in recent) / max(1, sum(x[1] for x in recent))
        since = min(days) * DAY
        return {"currentHashrate": rate * share_now, "currentShare": share_now, "networkHashrate": rate, "since": since,
                "complete": since <= end - span + DAY, "hashrates": points}

    def solo(self, period):
        """the hashrate of miners without a pool, as far as blocks show it: the blocks of solo services plus the blocks that carry no
        pool tag and no known payout address (an upper bound: a small pool missing from the list lands there too), times the network's hashrate"""
        p = self.pools(period)
        with self.lock:
            rate = self.now[0]
        total = max(1, p["blockCount"])
        sources = []
        for e in p["pools"]:
            if SOLO_RX.search(e["name"]):
                kind, name = "service", e["name"]
            elif e["name"] == "Unknown":
                kind, name = "unattributed", "No pool tag or known payout address"
            else:
                continue
            sources.append({"name": name, "kind": kind, "blockCount": e["blockCount"], "share": e["blockCount"] / total, "hashrate": rate * e["blockCount"] / total})
        blocks = sum(x["blockCount"] for x in sources)
        out = {"window": p["window"], "blockCount": p["blockCount"], "soloBlocks": blocks, "share": blocks / total, "currentHashrate": rate * blocks / total,
               "networkHashrate": rate, "sources": sources}
        for k in ("epochStart", "nextAdjustment", "epochBlocks"):
            if k in p:
                out[k] = p[k]
        return out

    def pools(self, period):
        with self.lock:
            heights = [(h, p, self.miner_of.get(h, "")) for h, p in self.pool_of.items()]
        if not heights:
            raise RuntimeError("no data yet")
        times = {h: self.headers[h][0] for h, _, _ in heights if h in self.headers}
        if period == "epoch":              # since the last difficulty adjustment: every block read of the current 2016-block period
            top = max(h for h, _, _ in heights)
            start = top - top % EPOCH
            rows = [(p, m) for h, p, m in heights if h >= start]
            return {"window": "epoch", "blockCount": len(rows), "pools": self.pool_split(rows), "epochStart": start, "nextAdjustment": start + EPOCH, "epochBlocks": top - start + 1}
        if period == "14d":                # the last difficulty period: the last 2016 blocks, as far as they have been read
            top = max(h for h, _, _ in heights)
            if min(h for h, _, _ in heights) <= top - EPOCH + 1:
                rows = [(p, m) for h, p, m in heights if h > top - EPOCH]
                return {"window": "14d", "blockCount": len(rows), "pools": self.pool_split(rows)}
        newest = max(times.values()), min(times.values())
        # the nearest period (not longer than asked for) that the blocks read so far reach back to
        want = POOL_WINDOWS.get(period, POOL_WINDOWS["1m"])
        fits = [(sec, name) for name, sec in POOL_WINDOWS.items() if sec <= want and newest[1] <= newest[0] - sec + 3600]
        sec, name = max(fits) if fits else (min(POOL_WINDOWS.values()), "24h")
        rows = [(p, m) for h, p, m in heights if h in times and times[h] >= newest[0] - sec]
        return {"window": name, "blockCount": len(rows), "pools": self.pool_split(rows)}


NODE = BtcRpc(os.environ["RPC_HOST"], os.environ.get("RPC_PORT", "8332"), os.environ["RPC_USER"], os.environ["RPC_PASS"])
STATS = ChainStats(CHAIN, NODE)


# ---------- the block being hashed: header of the node's block template ----------
# A miner builds its block from the node's getblocktemplate. The merkle root follows from that template: the coinbase
# (the miner's own, here a placeholder with the real height, reward and witness commitment) and the txids of the
# transactions chosen by fee rate. The nonce is not part of any public data: it is only known once a block is found,
# so the template reports it as null and the block it finds shows the real one (getblockheader "nonce").

def _dsha(b):
    return hashlib.sha256(hashlib.sha256(b).digest()).digest()


def _blake(b):
    return hashlib.blake2b(b, digest_size=32).digest()


def _varint(n):
    return bytes([n]) if n < 0xfd else b"\xfd" + struct.pack("<H", n) if n <= 0xffff else b"\xfe" + struct.pack("<I", n)


def _height_push(h):
    """BIP34: the block height as the first push of the coinbase script"""
    b = h.to_bytes((h.bit_length() + 8) // 8, "little")
    return bytes([len(b)]) + b


def merkle_root(leaves, fn):
    level = list(leaves)
    while len(level) > 1:
        if len(level) % 2:
            level.append(level[-1])
        level = [fn(level[i] + level[i + 1]) for i in range(0, len(level), 2)]
    return level[0]


def merkle_branch(leaves, fn):
    """the hashes a miner combines with its own coinbase txid to get the merkle root (stratum's merkle branch)"""
    branch, level = [], list(leaves)
    while len(level) > 1:
        if len(level) % 2:
            level.append(level[-1])
        branch.append(level[1])
        level = [fn(level[i] + level[i + 1]) for i in range(0, len(level), 2)]
    return branch


MERKLE = {"fn": None, "name": "unverified"}


def merkle_hash():
    """Which hash builds the merkle tree of this chain: checked once against the merkle root of the node's own tip block."""
    if MERKLE["fn"]:
        return MERKLE["fn"], MERKLE["name"]
    try:
        tip = NODE.call("getblock", NODE.call("getblockhash", int(NODE.call("getblockcount"))), 1)
        leaves = [bytes.fromhex(t)[::-1] for t in tip["tx"]]
        for name, fn in (("sha256d", _dsha), ("blake2b", _blake)):
            if merkle_root(leaves, fn)[::-1].hex() == tip.get("merkleroot"):
                MERKLE["fn"], MERKLE["name"] = fn, name
                return fn, name
    except Exception as exc:
        log("merkle check: " + str(exc))
    return _dsha, "unverified"


TEMPLATE = {"at": 0, "data": None}
TEMPLATE_LOCK = threading.Lock()


def block_template():
    with TEMPLATE_LOCK:
        if TEMPLATE["data"] and time.time() - TEMPLATE["at"] < 8:
            return TEMPLATE["data"]
        t = NODE.call("getblocktemplate", {"rules": ["segwit", "blake2b"] if CHAIN == "blake2b" else ["segwit"]})   # Knots on the BLAKE2b chain asks the client to name the blake2b rule
        fn, how = merkle_hash()
        tag = b"/hashes.space/"
        script = _height_push(t["height"]) + bytes([len(tag)]) + tag
        outs = [(t["coinbasevalue"], b"\x51")]
        if t.get("default_witness_commitment"):
            outs.append((0, bytes.fromhex(t["default_witness_commitment"])))
        cb = struct.pack("<I", 2) + b"\x01" + b"\x00" * 32 + b"\xff\xff\xff\xff" + _varint(len(script)) + script + b"\xff\xff\xff\xff"
        cb += _varint(len(outs)) + b"".join(struct.pack("<q", v) + _varint(len(s_)) + s_ for v, s_ in outs) + struct.pack("<I", 0)
        leaves = [fn(cb)] + [bytes.fromhex(x["txid"])[::-1] for x in t.get("transactions", [])]
        tip = NODE.call("getblockheader", t["previousblockhash"])
        data = {"height": t["height"], "version": t["version"], "previousblockhash": t["previousblockhash"], "merkleroot": merkle_root(leaves, fn)[::-1].hex(),
                "merklebranch": [h.hex() for h in merkle_branch(leaves, fn)], "merkleHash": how, "coinbase": "placeholder",
                "time": t["curtime"], "bits": t["bits"], "target": t["target"], "nonce": None,
                "nTx": len(leaves), "fees": sum(int(x.get("fee", 0)) for x in t.get("transactions", [])), "coinbasevalue": t["coinbasevalue"],
                "weight": sum(int(x.get("weight", 0)) for x in t.get("transactions", [])), "tipNonce": tip.get("nonce")}
        TEMPLATE["data"], TEMPLATE["at"] = data, time.time()
        return data


def difficulty_adjustment():
    """Where the chain is in its difficulty period (2016 blocks), as mempool's /api/v1/difficulty-adjustment."""
    tip = int(NODE.call("getblockcount"))
    start = tip - tip % EPOCH
    t_tip, t_start = STATS.header(tip)[0], STATS.header(max(1, start))[0]
    done = tip - start
    avg = (t_tip - t_start) / done if done else 600.0
    if avg <= 0:
        avg = 600.0
    change = max(-75.0, min(300.0, (600.0 / avg - 1) * 100)) if done else 0.0
    left = EPOCH - done
    prev = None
    if start - EPOCH >= 1:
        w1, w0 = STATS.header(max(1, start))[2], STATS.header(start - EPOCH)[2]
        prev = (w1 / w0 - 1) * 100 if w0 else None
    return {"progressPercent": round(done / EPOCH * 100, 2), "difficultyChange": round(change, 2), "estimatedRetargetDate": int((t_tip + left * avg) * 1000),
            "remainingBlocks": left, "remainingTime": int(left * avg * 1000), "previousRetarget": None if prev is None else round(prev, 2),
            "previousTime": t_start, "nextRetargetHeight": start + EPOCH, "timeAvg": int(avg * 1000), "expectedBlocks": round((t_tip - t_start) / 600.0, 1) if done else 0}


def recommended_fees():
    """Fee rates (sat/vB) from your own mempool: the blocks it would build next, best fee rate first."""
    with STATE_LOCK:
        mb = STATE["mempool"]
    if not mb:
        raise RuntimeError("no mempool data yet")
    low = float(NODE.call("getmempoolinfo").get("mempoolminfee", 0.00001)) * 1e5      # BTC/kvB -> sat/vB
    med = [b["medianFee"] for b in mb]
    at = lambda i: med[min(i, len(med) - 1)]
    minimum = max(round(low, 2), 0.1)
    return {"fastestFee": max(minimum, at(0)), "halfHourFee": max(minimum, at(1)), "hourFee": max(minimum, at(2)),
            "economyFee": max(minimum, round(mb[-1]["feeRange"][1], 2)), "minimumFee": minimum}


def halving():
    tip = int(NODE.call("getblockcount"))
    nxt = (tip // 210000 + 1) * 210000
    left = nxt - tip
    t_tip = STATS.header(tip)[0]
    return {"height": tip, "nextHalvingHeight": nxt, "remainingBlocks": left, "estimatedDate": int((t_tip + left * 600) * 1000),
            "subsidyNow": (SUBSIDY0 >> (tip // 210000)) / 1e8, "subsidyNext": (SUBSIDY0 >> (nxt // 210000)) / 1e8}


def network():
    ni, mi, ci = NODE.call("getnetworkinfo"), NODE.call("getmempoolinfo"), NODE.call("getblockchaininfo")
    return {"node": ni.get("subversion"), "protocol": ni.get("protocolversion"), "connections": ni.get("connections"),
            "connectionsIn": ni.get("connections_in"), "connectionsOut": ni.get("connections_out"),
            "mempool": {"count": mi.get("size"), "vsize": mi.get("bytes"), "memory": mi.get("usage"), "totalFee": mi.get("total_fee"),
                        "minFeeRate": float(mi.get("mempoolminfee", 0)) * 1e5, "fullRbf": mi.get("fullrbf")},
            "chain": {"blocks": ci.get("blocks"), "headers": ci.get("headers"), "sizeOnDisk": ci.get("size_on_disk"), "pruned": ci.get("pruned"),
                      "pruneHeight": ci.get("pruneheight"), "verificationProgress": ci.get("verificationprogress")}}


def block_statistics(ident):
    """Statistics of one block: fees and fee rates (the node's undo data), SegWit and Taproot share, OP_RETURN, total sent."""
    h = NODE.call("getblockhash", int(ident)) if str(ident).isdigit() else ident
    if not HEX64.fullmatch(h):
        raise ValueError("not a block")
    st = NODE.call("getblockstats", h, timeout=120)
    out = {"hash": h, "height": st["height"], "timestamp": st["time"], "txs": st["txs"], "totalFees": st["totalfee"], "avgFee": st["avgfee"], "medianFee": st["medianfee"],
           "minFee": st["minfee"], "maxFee": st["maxfee"], "avgFeeRate": st["avgfeerate"], "minFeeRate": st["minfeerate"], "maxFeeRate": st["maxfeerate"],
           "feeRatePercentiles": st.get("feerate_percentiles"), "size": st["total_size"], "weight": st["total_weight"], "avgTxSize": st["avgtxsize"],
           "segwitTxs": st["swtxs"], "segwitShare": round(st["swtxs"] / st["txs"], 4) if st["txs"] else 0, "inputs": st["ins"], "outputs": st["outs"],
           "totalOut": st["total_out"], "subsidy": st["subsidy"], "utxoIncrease": st["utxo_increase"], "utxoSizeIncrease": st["utxo_size_inc"]}
    b = NODE.call("getblock", h, 2, timeout=120)       # the outputs' types: Taproot and OP_RETURN
    tap = opret = 0
    for t in b["tx"][1:]:
        types = [o.get("scriptPubKey", {}).get("type") for o in t["vout"]]
        tap += "witness_v1_taproot" in types
        opret += types.count("nulldata")
    n = max(1, len(b["tx"]) - 1)
    out.update({"taprootTxs": tap, "taprootShare": round(tap / n, 4), "opReturnOutputs": opret})
    return out


def chain_tips():
    """Every chain the node knows: the active one and the forks (stale blocks) next to it."""
    tips = NODE.call("getchaintips")
    out = []
    for t in sorted(tips, key=lambda x: -x["height"]):
        try:
            hd = NODE.call("getblockheader", t["hash"])
            when = hd.get("time")
        except Exception:  # noqa: BLE001
            when = None
        out.append({"height": t["height"], "hash": t["hash"], "branchLength": t["branchlen"], "status": t["status"], "timestamp": when,
                    "stale": t["status"] != "active" and t["branchlen"] > 0})
    return out


def tx_projection(txid):
    """Where a mempool transaction lands: the block of the projected blocks it fits in, its CPFP package, and whether it can be replaced."""
    e = NODE.call("getmempoolentry", txid)
    v = e.get("vsize") or e.get("size") or 1
    f = e.get("fees", {})
    base = float(f.get("base", e.get("fee", 0))) * 1e8
    own = base / v
    anc = float(f.get("ancestor", 0)) * 1e8 / max(1, e.get("ancestorsize", v))
    desc = float(f.get("descendant", 0)) * 1e8 / max(1, e.get("descendantsize", v))
    rate = max(own, anc, desc)                  # what a miner sees: the best of its own rate and its packages' rates
    with STATE_LOCK:
        mb = STATE["mempool"]
    slot = None
    for i, b in enumerate(mb):
        if rate >= b["feeRange"][0]:
            slot = i
            break
    mi = NODE.call("getmempoolinfo")
    signals = None
    try:
        raw = NODE.call("getrawtransaction", txid, True)
        signals = any(int(i.get("sequence", 0xffffffff)) < 0xfffffffe for i in raw["vin"])
    except Exception:  # noqa: BLE001
        pass
    return {"txid": txid, "vsize": v, "fee": round(base), "feeRate": round(own, 2), "effectiveFeeRate": round(rate, 2),
            "ancestors": e.get("ancestorcount", 1) - 1, "descendants": e.get("descendantcount", 1) - 1,
            "ancestorFeeRate": round(anc, 2), "descendantFeeRate": round(desc, 2),
            "projectedBlock": slot, "etaMinutes": None if slot is None else (slot + 1) * 10,
            "minFeeOfNextBlock": mb[0]["feeRange"][0] if mb else None, "minFeeOfLastProjected": mb[-1]["feeRange"][0] if mb else None,
            "signalsRbf": signals, "nodeReplacesWithoutSignal": bool(mi.get("fullrbf")), "replaceable": bool(signals) or bool(mi.get("fullrbf")),
            "bip125Replaceable": e.get("bip125-replaceable"), "age": int(time.time() - e.get("time", time.time()))}


ADDR_RE = re.compile(r"[A-Za-z0-9]{14,90}")
ADDR = {}                                   # address -> {"state": scanning|done|error, "result"|"error", "at"}
ADDR_LOCK = threading.Lock()                # one scan at a time: it reads the whole UTXO set
SCAN_RPC = None


def address_scan(addr):
    """Start (or read) the balance scan of one address. scantxoutset reads the whole UTXO set, so it runs in the background."""
    if not ADDRESS_SCAN:
        raise ValueError("address balances are switched off on this explorer")
    if not ADDR_RE.fullmatch(addr) or not NODE.call("validateaddress", addr).get("isvalid"):
        raise ValueError("not a valid address")
    hit = ADDR.get(addr)
    if hit and hit["state"] == "done" and time.time() - hit["at"] < 600:
        return hit
    if hit and hit["state"] == "scanning":
        return hit
    if not ADDR_LOCK.acquire(blocking=False):
        return {"state": "busy", "at": time.time()}
    ADDR[addr] = {"state": "scanning", "at": time.time()}

    def run():
        global SCAN_RPC
        try:
            if SCAN_RPC is None:        # its own connection: the scan must not hold up the explorer's other calls
                SCAN_RPC = BtcRpc(NODE.host, NODE.port, os.environ["RPC_USER"], os.environ["RPC_PASS"])
            r = SCAN_RPC.call("scantxoutset", "start", ["addr(" + addr + ")"], timeout=900)
            ADDR[addr] = {"state": "done", "at": time.time(), "result": {"address": addr, "balance": round(float(r.get("total_amount", 0)) * 1e8),
                          "unspents": [{"txid": u["txid"], "vout": u["vout"], "value": round(float(u["amount"]) * 1e8), "height": u.get("height")} for u in r.get("unspents", [])][:200],
                          "unspentCount": len(r.get("unspents", [])), "scannedAtHeight": r.get("height")}}
        except Exception as exc:  # noqa: BLE001
            ADDR[addr] = {"state": "error", "at": time.time(), "error": str(exc)}
        finally:
            ADDR_LOCK.release()
            for k in [k for k, v in ADDR.items() if time.time() - v["at"] > 3600]:
                ADDR.pop(k, None)
    threading.Thread(target=run, daemon=True).start()
    return ADDR[addr]


def spent_or_pruned_tx(txid):
    """A pruned node cannot read a transaction that left its blocks, but the UTXO set still knows the unspent outputs of recent
    and unspent transactions: find those (gettxout), and say what the node can tell about the rest."""
    found = []
    for n in range(0, 24):
        try:
            o = NODE.call("gettxout", txid, n, True)
        except Exception:  # noqa: BLE001
            break
        if o:
            found.append((n, o))
        elif n >= 4 and not found:
            break
    return found


def check_node():
    """Refuse a node of the other chain: the Bitcoin Explorer reads the regular Bitcoin chain (the Bitcoin Node app, or Libre Relay,
    a Bitcoin Core fork), the BLAKE2b Explorer the Bitcoin Knots app. Umbrel lets you choose the Bitcoin app per app, so a wrong choice would otherwise show
    the wrong chain without a word. Set STRICT_NODE=0 to switch the check off."""
    if os.environ.get("STRICT_NODE", "1") == "0":
        return
    sub = NODE.call("getnetworkinfo").get("subversion", "")
    knots = "knots" in sub.lower()          # Libre Relay is a Bitcoin Core fork on the regular Bitcoin chain, so it counts as Bitcoin
    if CHAIN == "blake2b" and not knots:
        raise RuntimeError("this explorer is connected to " + sub + ", not to the Bitcoin Knots app: in Umbrel, choose Bitcoin Knots for it")
    if CHAIN == "sha256" and knots:
        raise RuntimeError("this explorer is connected to " + sub + ", not to the regular Bitcoin Node app: in Umbrel, choose Bitcoin Node for it")
STATE = {"blocks": [], "mempool": [], "mempool_json": "", "error": "starting", "info": {}, "mempool_count": 0, "at": 0}
STATE_LOCK = threading.Lock()


def stats_worker():
    """hashrate and pool statistics: recomputed every 10 minutes (the first run reads the pool of every block of the period)"""
    while True:
        try:
            check_node()
            STATS.refresh_hashrate()
            STATS.refresh_pools()
            STATS.update_shares()
            STATS.refresh_history()
            log("mining statistics ready (tip " + str(STATS.tip) + ")")
        except Exception as exc:  # noqa: BLE001
            STATS.error = str(exc)
            log("mining statistics: " + str(exc))
        time.sleep(600)


# ---------- WebSocket (mempool protocol) ----------

_clients = set()
_clients_lock = threading.Lock()
_send_lock = threading.Lock()


def ws_send(sock, text):
    data = text.encode()
    head = bytearray([0x81])
    if len(data) < 126:
        head.append(len(data))
    elif len(data) < 65536:
        head += bytes([126]) + struct.pack(">H", len(data))
    else:
        head += bytes([127]) + struct.pack(">Q", len(data))
    with _send_lock:
        sock.sendall(bytes(head) + data)


def broadcast(obj):
    text = json.dumps(obj)
    with _clients_lock:
        dead = []
        for c in _clients:
            try:
                ws_send(c, text)
            except OSError:
                dead.append(c)
        for c in dead:
            _clients.discard(c)


def view(b):
    return {k: v for k, v in b.items() if k != "previousblockhash"}


def poller():
    """every few seconds: is there a new block (pushed to the page at once), and every 20 seconds the mempool blocks"""
    last_mempool = 0
    while True:
        try:
            check_node()
            info = NODE.call("getblockchaininfo")
            if not POOLS.tags:
                raise RuntimeError("the list of mining pools is still loading")
            if info.get("initialblockdownload"):
                raise RuntimeError("the node is still syncing (" + "{:.1f}".format(info.get("verificationprogress", 0) * 100) + "%)")
            blocks = STATS.refresh_live_blocks()
            try:
                info["subversion"] = NODE.call("getnetworkinfo").get("subversion", "")     # which node answers: shows in /api/v1/status
            except Exception:  # noqa: BLE001
                pass
            fresh = STATE["blocks"] and blocks[0]["id"] != STATE["blocks"][0]["id"] and blocks[0]["height"] > STATE["blocks"][0]["height"]
            with STATE_LOCK:
                STATE.update(blocks=blocks, info=info, error="", at=int(time.time()))
            if fresh:
                broadcast({"block": blocks[0]})
                last_mempool = 0                       # a block changes the mempool: recompute now
            if time.time() - last_mempool > 20:
                try:
                    mp, count = STATS.refresh_live_mempool()
                    text = json.dumps(mp)
                    with STATE_LOCK:
                        STATE["mempool_count"] = count
                    if text != STATE["mempool_json"]:
                        with STATE_LOCK:
                            STATE["mempool"], STATE["mempool_json"] = mp, text
                        broadcast({"mempool-blocks": mp})
                except Exception as exc:  # noqa: BLE001
                    log("mempool: " + str(exc))
                last_mempool = time.time()
        except Exception as exc:  # noqa: BLE001
            with STATE_LOCK:
                STATE["error"] = str(exc)
            log("poll: " + str(exc))
        time.sleep(6)


def need_live():
    with STATE_LOCK:
        if STATE["error"] or not STATE["blocks"]:
            raise RuntimeError(STATE["error"] or "no data yet")
        return STATE["blocks"], STATE["mempool"]


# ---------- DATUM verified community: payout addresses are shown only to members who signed in with Discord ----------
# The explorer never shows the addresses a pool pays out to (block page, transaction list, animation, transaction and address pages) until the visitor
# has signed in with Discord and holds the DATUM Verified role on the community server. Setup: put a file discord.json in this app's data folder:
#   {"client_id": "...", "client_secret": "...", "guild_id": "<server id>", "role_id": "<DATUM Verified role id>", "public_url": "https://btc.hashes.space"}
# (or the environment variables DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID, DISCORD_ROLE_ID, PUBLIC_URL). In the Discord developer portal add
# <public_url>/auth/discord/callback as a redirect of the application. Without that file nobody is verified and the addresses stay hidden.
STATE_DIR = os.environ.get("STATE_DIR", "/state")
VERIFY_DAYS = 7
REQ = threading.local()                       # per request: ok (verified), path, host, cookies to set


def discord_cfg():
    cfg = {}
    try:
        with open(os.path.join(STATE_DIR, "discord.json")) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        pass
    for k, env in (("client_id", "DISCORD_CLIENT_ID"), ("client_secret", "DISCORD_CLIENT_SECRET"), ("guild_id", "DISCORD_GUILD_ID"), ("role_id", "DISCORD_ROLE_ID"), ("public_url", "PUBLIC_URL")):
        if os.environ.get(env):
            cfg[k] = os.environ[env]
    return cfg if all(cfg.get(k) for k in ("client_id", "client_secret", "guild_id", "role_id")) else None


_SECRET = []


def session_secret():
    if not _SECRET:
        f = os.path.join(STATE_DIR, "session.key")
        try:
            with open(f, "rb") as fh:
                _SECRET.append(fh.read())
        except OSError:
            key = os.urandom(32)
            try:
                with open(f, "wb") as fh:
                    fh.write(key)
            except OSError:
                pass
            _SECRET.append(key)
    return _SECRET[0]


def sign(text):
    import hmac
    return hmac.new(session_secret(), text.encode(), hashlib.sha256).hexdigest()


def make_cookie(name, value, days):
    exp = int(time.time()) + int(days * 86400)
    return "{}={}.{}.{}; Path=/; Max-Age={}; HttpOnly; Secure; SameSite=Lax".format(name, value, exp, sign(name + "|" + value + "|" + str(exp)), int(days * 86400))


def read_cookie(header, name):
    """the value of a signed cookie made by make_cookie, or None when absent, expired or forged"""
    import hmac
    for part in (header or "").split(";"):
        k, _, v = part.strip().partition("=")
        if k == name:
            try:
                value, exp, sig = v.rsplit(".", 2)
                if int(exp) > time.time() and hmac.compare_digest(sig, sign(name + "|" + value + "|" + exp)):
                    return value
            except ValueError:
                return None
    return None


PROTECTED_POOL = "OCEAN"     # on the Bitcoin (SHA-256) explorer only blocks mined by this pool are for the verified community; on the BLAKE2b explorer every pool's blocks are


def protect(pool):
    """mark the page being built as showing a pool's payout information: the BLAKE2b explorer protects every pool, the Bitcoin explorer only OCEAN"""
    REQ.protected = CHAIN == "blake2b" or pool == PROTECTED_POOL


def is_verified():
    """may this visitor see payout addresses and the whole block: yes when signed in with the DATUM Verified role, and always for blocks that are not protected"""
    return bool(getattr(REQ, "ok", False)) or not getattr(REQ, "protected", True)


def out_label(o, short=False):
    """what a transaction output shows: its address (hidden for visitors who are not verified), or its script type"""
    spk = o.get("scriptPubKey", {})
    a = spk.get("address")
    if not a:
        return spk.get("type", "")
    if not is_verified():
        return "hidden"
    return short_addr(a) if short else a


def verify_box(full=True):
    """the lock shown in place of payout addresses: what the community is for, and the Get verified button (full=False: just the button)"""
    nxt = urllib.request.quote(getattr(REQ, "path", "/") or "/", safe="/")
    btn = "<a class=verify href='/auth/discord?next=" + nxt + "'><span aria-hidden=true>&#128274;</span> Get verified</a>"
    if not full:
        return "<span class=locked>" + btn + "</span>"
    return ("<div class=locked><p><b>Only DATUM Verified pool contributors have access to transaction information of the pool they are hashing on.</b></p>"
            "<p class=muted>Join for free and confirm your payout address by proving you hash " + NAME + " blocks on a DATUM verified pool.</p>" + btn + "</div>")


def discord_call(url, data=None, token=None):
    req = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode() if data else None,
                                 headers={"User-Agent": "hashes-space-explorer (+https://hashes.space)", **({"Authorization": "Bearer " + token} if token else {}),
                                          **({"Content-Type": "application/x-www-form-urlencoded"} if data else {})})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read().decode())


def auth_start(next_path):
    cfg = discord_cfg()
    if not cfg:
        return None, page("Get verified", "<h1>Get verified</h1><section class=card><p>Payout addresses are shown to members of the DATUM verified community. Sign-in with Discord is not set up on this explorer yet, "
                          "so they stay hidden for now.</p><p><a href='/'>Back to the explorer</a></p></section>")
    state = os.urandom(12).hex()
    REQ.cookies.append(make_cookie("dvs", state + "~" + urllib.request.quote(next_path, safe="/"), 0.01))
    redirect = (cfg.get("public_url") or "https://" + getattr(REQ, "host", "")).rstrip("/") + "/auth/discord/callback"
    url = "https://discord.com/oauth2/authorize?" + urllib.parse.urlencode({"client_id": cfg["client_id"], "response_type": "code", "redirect_uri": redirect,
                                                                           "scope": "identify guilds.members.read", "state": state, "prompt": "none"})
    return url, None


def auth_callback(params, cookie_header):
    """Discord sends the visitor back with a code: swap it for a token, read the visitor's roles on the community server, and sign the visit when the DATUM Verified role is there"""
    cfg = discord_cfg()
    saved = read_cookie(cookie_header, "dvs") or ""
    state, _, nxt = saved.partition("~")
    nxt = urllib.request.unquote(nxt)
    if not nxt.startswith("/") or nxt.startswith("//"):
        nxt = "/"
    if not cfg or not state or params.get("state") != state or not params.get("code"):
        return None, page("Get verified", "<h1>Sign-in did not finish</h1><section class=card><p>The sign-in expired or was cancelled. <a href='/auth/discord?next=" + urllib.request.quote(nxt, safe="/") + "'>Try again</a>.</p></section>")
    redirect = (cfg.get("public_url") or "https://" + getattr(REQ, "host", "")).rstrip("/") + "/auth/discord/callback"
    try:
        tok = discord_call("https://discord.com/api/oauth2/token", {"client_id": cfg["client_id"], "client_secret": cfg["client_secret"], "grant_type": "authorization_code",
                                                                      "code": params["code"], "redirect_uri": redirect})
        member = discord_call("https://discord.com/api/users/@me/guilds/" + str(cfg["guild_id"]) + "/member", token=tok["access_token"])
    except (OSError, ValueError, KeyError):
        return None, page("Get verified", "<h1>You are not in the DATUM verified community yet</h1><section class=card><p>Join the community and verify with the DATUM Verify bot first (only miners "
                          "that submit shares through DATUM Gateway can join), then sign in again.</p><p><a href='https://datumgateway.org'>datumgateway.org</a> · <a href='" + nxt + "'>Back</a></p></section>")
    if str(cfg["role_id"]) not in [str(x) for x in member.get("roles", [])]:
        return None, page("Get verified", "<h1>The DATUM Verified role is missing</h1><section class=card><p>You are on the server, but the DATUM Verify bot has not verified you yet. "
                          "Verify with the bot, then sign in again.</p><p><a href='https://datumgateway.org'>datumgateway.org</a> · <a href='" + nxt + "'>Back</a></p></section>")
    REQ.cookies.append(make_cookie("dv", "1", VERIFY_DAYS))
    REQ.cookies.append("dvs=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax")
    return nxt, None


