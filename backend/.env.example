# HTTP + WebSocket port
PORT=8080

# The networks (any proof-of-work hash function) and their sources are in networks.json.
# NETWORKS_FILE=./networks.json
# CHAIN_SOURCE=simulated     makes every network simulated (a classroom without internet)
# DEFAULT_ALGO=sha256        hash function of miners that don't set one (default: the first network's)

# "Connect your own node and Electrum server" button (the server connects to addresses users enter)
ALLOW_OWN_NODE=true

# Find ASIC: find miners powered on in the local network (the backend must run in that network)
ALLOW_SCAN=true
# SCAN_PORT=4028
# SCAN_SUBNETS=192.168.2,10.0.5
# CPU miners: ports where XMRig's HTTP API may answer, and its access token (one for all, or per IP)
# SCAN_XMRIG_PORTS=18088
# XMRIG_ACCESS_TOKEN=
# your own Monero block explorer (the hashes Monero Explorer app on your Umbrel) instead of xmrchain.net
# MONERO_EXPLORER_URL=http://umbrel.local:4081
# XMRIG_TOKENS={"192.168.1.40":"token"}

# --- the server's own node (Core/Knots-style RPC), for networks with "source": "node" and no rpcUrl ---
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# or use cookie auth instead of user/password:
# BITCOIN_RPC_COOKIE=/home/bitcoin/.bitcoin/.cookie
NODE_LABEL=Bitcoin Knots
NODE_POLL_MS=5000

# --- miners ---
MINER_POLL_MS=5000
MINER_IDLE_MS=120000
MINER_OFFLINE_MS=60000
# spawn demo rigs for tenants with no registered miners
SIMULATE_MINERS=true

TENANTS_FILE=./tenants.json
MINERS_FILE=./miners.json

# --- firmware plugins: one .js file per firmware (see firmware/README.md) ---
# FIRMWARE_DIR=./firmware
